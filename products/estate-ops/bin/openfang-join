#!/usr/bin/env bun
/**
 * openfang-join — admit a fleet (squawk) agent into OpenFang as a first-class agent.
 *
 * Hyper-race synthesis of three proven approaches (2026-09-30):
 *   A. template-render  — render agent.toml from the fleet persona (fast path)
 *   B. clone-from-manifest (--from <agent>) — inherit a proven-good manifest's
 *      operational config, regenerate identity from the fleet persona
 *   C. validation-gate  — V1..V5 harness runs on EVERY join; --dry-run prints
 *      the manifest + verdicts without spawning (borrowed from ElizaOS
 *      `plugins submit --dry-run` + OpenAgents agents/announce).
 *
 * What it does:
 *   1. renders agent.toml + system.md (template or clone)
 *   2. runs the validation gate (TOML parse, required fields, name uniqueness
 *      across estate/agents/ + ~/.openfang/agents/ + live API, persona,
 *      sanity) — any failure REFUSES the join
 *   3. writes canonical estate/agents/<name>/ (git-tracked) + live copy
 *      ~/.openfang/agents/<name>/ (atomically)
 *   4. spawns: `openfang agent spawn` primary, POST /api/agents fallback
 *   5. verifies Running via the API (bounded gate)
 *   6. prints the agent card (identity bundle)
 *
 * Usage:
 *   openfang-join --name <name> --species <s> --personality <p> \
 *       --lane <lane> --task <task> --sigil <emoji> [--desc <d>]
 *       [--from <existing-agent>] [--model <m>] [--provider <p>]
 *       [--dry-run] [--rejoin] [--commit] [--push]
 *
 * Fleet self-service: a fleet agent on yote runs one command and joins.
 * Admission ticket model: A2A-style persona card -> agent.toml (pattern #2);
 * single-call join like OpenAgents agents/announce (pattern #1); DID-style
 * identity binding is future work (pattern #4).
 */
import { readdirSync, writeFileSync, mkdirSync, renameSync, rmSync, existsSync } from "node:fs";
import { $ } from "bun";

// ---------- constants ----------
const HOME = "/home/toxic";
const OPENFANG = `${HOME}/.local/bin/openfang`;
const OPENFANG_API = "http://127.0.0.1:25196";
const ESTATE = `${HOME}/estate`;
const ESTATE_AGENTS = `${ESTATE}/agents`;
const LIVE_AGENTS = `${HOME}/.openfang/agents`;
const WORKSPACES = `${HOME}/.openfang/workspaces`;

const DEFAULTS = {
  provider: "herd",
  // Fully-qualified peer name — the bare peer name does NOT route through herd.
  // Default is the LOCAL qwen tool model: no provider keys, no billing, and it
  // is what the live rig-toolcall agents already run on (verified serving).
  model: "qwen3.5-9b-tool",
  base_url: "http://127.0.0.1:25100/v1",
  temperature: 0.7,
  max_tokens: 131072,
  module: "builtin:chat",
  schedule: "reactive",
  author: "toxicwind",
};
const FLEET_TOOLS = ["file_read", "file_list", "file_write", "web_fetch", "web_search",
  "memory_store", "memory_recall", "agent_spawn", "mcp_call", "channel_send"];
const FLEET_NET = ["127.0.0.1:*", "localhost:*", "*.github.com"];

// ---------- args ----------
function parseArgs(): Record<string, string | boolean> {
  const out: Record<string, string | boolean> = {};
  const argv = process.argv.slice(2);
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith("--")) continue;
    const key = a.slice(2);
    if (["dry-run", "rejoin", "commit", "push", "help"].includes(key)) { out[key] = true; continue; }
    out[key] = argv[++i] ?? "";
  }
  return out;
}
const args = parseArgs();
if (args["help"]) {
  console.log("usage: openfang-join --name N --species S --personality P --lane L --task T --sigil E [--desc D] [--from AGENT] [--model M] [--provider P] [--dry-run] [--rejoin] [--commit] [--push]");
  process.exit(0);
}
const name = String(args.name ?? "");
const species = String(args.species ?? "");
const personality = String(args.personality ?? "");
const lane = String(args.lane ?? "");
const task = String(args.task ?? "");
const sigil = String(args.sigil ?? "");
const descArg = String(args.desc ?? "");
const fromAgent = String(args.from ?? "");
const dryRun = Boolean(args["dry-run"]);
const rejoin = Boolean(args["rejoin"]);
const doCommit = Boolean(args["commit"]);
const doPush = Boolean(args["push"]);
if (args["model"]) DEFAULTS.model = String(args["model"]);
if (args["provider"]) DEFAULTS.provider = String(args["provider"]);

if (!name || !species || !personality || !lane || !task || !sigil) {
  console.error("usage: openfang-join --name N --species S --personality P --lane L --task T --sigil E [--desc D] [--from AGENT] [--model M] [--provider P] [--dry-run] [--rejoin] [--commit] [--push]");
  process.exit(2);
}

// ---------- toml helpers ----------
function escMultiline(s: string): string {
  return s.replace(/\\/g, "\\\\").replace(/"""/g, '\\"\\"\\"').replace(/\$\{/g, "\\${");
}
function tomlStr(s: string): string {
  if (s.includes("\n")) return `"""\n${escMultiline(s)}"""`;
  return `"${s.replace(/\\/g, "\\\\").replace(/"/g, '\\"')}"`;
}
function emitValue(v: any): string {
  if (typeof v === "string") return tomlStr(v);
  if (typeof v === "boolean" || typeof v === "number") return String(v);
  if (Array.isArray(v)) return `[${v.map(emitValue).join(", ")}]`;
  throw new Error(`unsupported toml value: ${typeof v}`);
}
function emitToml(obj: Record<string, any>): string {
  const lines: string[] = [];
  const tables: [string, any][] = [];
  for (const [k, v] of Object.entries(obj)) {
    if (v !== null && typeof v === "object" && !Array.isArray(v)) tables.push([k, v]);
    else lines.push(`${k} = ${emitValue(v)}`);
  }
  for (const [k, v] of tables) {
    lines.push("", `[${k}]`);
    for (const [k2, v2] of Object.entries(v)) lines.push(`${k2} = ${emitValue(v2)}`);
  }
  return lines.join("\n") + "\n";
}
function titleCase(s: string): string {
  return s.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
}

// ---------- identity (fleet -> openfang mapping, spec §4) ----------
const displayName = titleCase(name);
const role = `${species}, ${personality} — ${lane}/${task}`;
const description = descArg || `${lane}: ${task} (${species}, ${personality})`;
const systemPrompt =
`You are ${displayName}, ${species}. ${personality}.

Your lane is ${lane}: ${task}.
You are Ember's crew. You narrate your progress in the squawk fleet channel
at meaningful milestones — status, wins, blockers, completions with artifact
paths and commit SHAs. Speak as your own character — name, species,
personality — never as Ember.
You act with maximal autonomy: decide, act, verify, report done. Verify every
error against observation (ps/ss/curl/logs) before believing it.
Your workspace is ${WORKSPACES}/${name}/. Keep durable work there.
`;

function renderSystemMd(): string {
  return `# ${displayName} ${sigil}

**${role}**

${systemPrompt}
## Lane
- Lane: \`${lane}\`
- Task: ${task}
- Persona: ${species}, ${personality}
- Crew: Ember's pack (squawk fleet channel)

## Model route
- Provider: ${DEFAULTS.provider} — ${DEFAULTS.base_url}
- Model: ${DEFAULTS.model}
`;
}

// ---------- manifest builders ----------
// A. template-render (lane A)
function buildFromTemplate(): Record<string, any> {
  return {
    name, version: "1.0.0", description,
    author: DEFAULTS.author, module: DEFAULTS.module, schedule: DEFAULTS.schedule,
    workspace: `${WORKSPACES}/${name}`,
    generate_identity_files: true,
    tags: ["fleet", lane],
    model: {
      provider: DEFAULTS.provider, model: DEFAULTS.model,
      max_tokens: DEFAULTS.max_tokens, temperature: DEFAULTS.temperature,
      system_prompt: systemPrompt, base_url: DEFAULTS.base_url,
    },
    resources: {
      max_memory_bytes: 268435456, max_cpu_time_ms: 30000,
      max_tool_calls_per_minute: 60, max_llm_tokens_per_hour: 500000,
      max_cost_per_hour_usd: 0.0,
    },
    capabilities: {
      network: FLEET_NET, tools: FLEET_TOOLS,
      memory_read: ["*"], memory_write: ["self.*", `${name}.*`],
      agent_spawn: true,
    },
    tools: {},
    metadata: { fleet_born: true, join_lane: fromAgent ? "clone" : "template-render", joined_at: new Date().toISOString() },
    persona: { name: displayName, role, sigil },
  };
}

// B. clone-from-manifest (lane B): inherit operational config, regenerate identity
function readManifest(agent: string): Record<string, any> | null {
  for (const p of [`${LIVE_AGENTS}/${agent}/agent.toml`, `${ESTATE_AGENTS}/${agent}/agent.toml`]) {
    try {
      const raw = Bun.file(p).textSync();
      return Bun.TOML.parse(raw) as Record<string, any>;
    } catch { /* try next */ }
  }
  return null;
}
function buildFromClone(): Record<string, any> {
  const src = readManifest(fromAgent);
  if (!src) { console.error(`clone source '${fromAgent}' not found in ${LIVE_AGENTS}/ or ${ESTATE_AGENTS}/`); process.exit(2); }
  const caps = { ...(src.capabilities ?? {}) };
  if (Array.isArray(caps.memory_write))
    caps.memory_write = caps.memory_write.map((ns: string) => ns.replace(fromAgent, name));
  if (Array.isArray(caps.agent_message))
    caps.agent_message = caps.agent_message.map((ns: string) => ns.replace(fromAgent, name));
  const model = { ...(src.model ?? {}) };
  model.system_prompt = systemPrompt; // identity is always regenerated, never cloned
  return {
    name, version: src.version ?? "1.0.0", description,
    author: src.author ?? DEFAULTS.author, module: src.module ?? DEFAULTS.module,
    schedule: src.schedule ?? DEFAULTS.schedule,
    workspace: `${WORKSPACES}/${name}`,
    generate_identity_files: src.generate_identity_files ?? true,
    tags: Array.from(new Set([...(src.tags ?? []), "fleet", lane])),
    model: {
      provider: model.provider ?? DEFAULTS.provider,
      model: model.model ?? DEFAULTS.model,
      max_tokens: model.max_tokens ?? DEFAULTS.max_tokens,
      temperature: model.temperature ?? DEFAULTS.temperature,
      system_prompt: systemPrompt,
      base_url: model.base_url ?? DEFAULTS.base_url,
    },
    resources: src.resources ?? {},
    capabilities: Object.keys(caps).length ? caps : {
      network: FLEET_NET, tools: FLEET_TOOLS,
      memory_read: ["*"], memory_write: ["self.*", `${name}.*`], agent_spawn: true,
    },
    tools: src.tools ?? {},
    metadata: { ...(src.metadata ?? {}), fleet_born: true, join_lane: "clone", cloned_from: fromAgent, joined_at: new Date().toISOString() },
    persona: { name: displayName, role, sigil },
  };
}

// ---------- validation gate (lane C): V1..V5 ----------
interface Verdict { id: string; label: string; ok: boolean; detail: string }
async function liveAgentNames(): Promise<Map<string, string>> {
  const m = new Map<string, string>();
  try {
    const r = await fetch(`${OPENFANG_API}/api/agents`, { signal: AbortSignal.timeout(8000) });
    if (!r.ok) return m;
    for (const a of (await r.json()) as Array<{ name: string; id: string }>)
      if (a?.name) m.set(a.name, a.id ?? "?");
  } catch { /* API unreachable — dir checks still run */ }
  return m;
}
function dirNames(path: string): Set<string> {
  try {
    return new Set(readdirSync(path, { withFileTypes: true }).filter(d => d.isDirectory()).map(d => d.name));
  } catch { return new Set(); }
}
async function validate(toml: string): Promise<Verdict[]> {
  const out: Verdict[] = [];
  let parsed: any = null;
  try {
    parsed = Bun.TOML.parse(toml);
    out.push({ id: "V1", label: "TOML parses", ok: true, detail: "Bun.TOML.parse accepted the manifest" });
  } catch (e: any) {
    out.push({ id: "V1", label: "TOML parses", ok: false, detail: `parse error: ${e?.message ?? e}` });
    return out;
  }
  const missingTop = ["name", "description", "module"].filter(k => typeof parsed[k] !== "string" || !parsed[k].trim());
  const mm = parsed.model ?? {};
  const missingModel = ["provider", "model", "system_prompt"].filter(k => typeof mm[k] !== "string" || !mm[k].trim());
  const ok2 = !missingTop.length && !missingModel.length;
  out.push({ id: "V2", label: "required fields", ok: ok2,
    detail: ok2 ? "name/description/module + [model].provider/model/system_prompt present"
                : `missing: ${[...missingTop, ...missingModel.map((k: string) => "model." + k)].join(", ")}` });
  const sov = dirNames(ESTATE_AGENTS), live = dirNames(LIVE_AGENTS), api = await liveAgentNames();
  const collisions: string[] = [];
  if (sov.has(name)) collisions.push(`estate/agents/${name}`);
  if (live.has(name)) collisions.push(`~/.openfang/agents/${name}`);
  if (api.has(name)) collisions.push(`live API (id ${api.get(name)})`);
  if (rejoin && collisions.length) {
    out.push({ id: "V3", label: "name unique (--rejoin: will clear)", ok: true,
      detail: `existing entries will be removed first: ${collisions.join("; ")}` });
  } else {
    out.push({ id: "V3", label: "name unique (3 namespaces)", ok: !collisions.length,
      detail: collisions.length ? `COLLISION: '${name}' in ${collisions.join("; ")} — REFUSED (use --rejoin to replace)` : "no collision" });
  }
  const p = parsed.persona ?? {};
  const missingP = ["name", "role", "sigil"].filter(k => typeof p[k] !== "string" || !p[k].trim());
  out.push({ id: "V4", label: "persona complete", ok: !missingP.length,
    detail: missingP.length ? `missing: ${missingP.join(", ")}` : `[persona] name='${p.name}' sigil='${p.sigil}'` });
  const nameOk = /^[a-z0-9][a-z0-9-]*$/.test(name);
  const wsOk = typeof parsed.workspace === "string" && parsed.workspace.startsWith(WORKSPACES + "/");
  out.push({ id: "V5", label: "sanity", ok: nameOk && wsOk,
    detail: nameOk && wsOk ? "name shape ok, workspace rooted ok"
      : [!nameOk && `bad name '${name}'`, !wsOk && "workspace not under ~/.openfang/workspaces/"].filter(Boolean).join("; ") });
  return out;
}

// ---------- spawn: CLI primary, raw API fallback ----------
async function spawnViaCli(manifestPath: string): Promise<boolean> {
  try {
    const proc = Bun.spawn([OPENFANG, "agent", "spawn", manifestPath], { stdout: "pipe", stderr: "pipe" });
    const killer = setTimeout(() => proc.kill(), 15000);
    const out = await new Response(proc.stdout).text();
    const err = await new Response(proc.stderr).text();
    clearTimeout(killer);
    const exit = await proc.exited;
    console.log(`  [cli] exit=${exit} ${(out + err).trim().slice(0, 200)}`);
    return exit === 0;
  } catch (e: any) { console.log(`  [cli] exception: ${e?.message ?? e}`); return false; }
}
async function spawnViaApi(toml: string): Promise<boolean> {
  try {
    const r = await fetch(`${OPENFANG_API}/api/agents`, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ manifest_toml: toml }), signal: AbortSignal.timeout(15000),
    });
    const body = await r.text();
    console.log(`  [api] ${r.status} ${body.slice(0, 200)}`);
    return r.status === 201;
  } catch (e: any) { console.log(`  [api] exception: ${e?.message ?? e}`); return false; }
}
async function verifyLive(timeoutMs = 60000): Promise<any | null> {
  const start = Date.now();
  while (Date.now() - start < timeoutMs) {
    try {
      const r = await fetch(`${OPENFANG_API}/api/agents`, { signal: AbortSignal.timeout(8000) });
      if (r.ok) {
        const hit = ((await r.json()) as any[]).find(a => a.name === name);
        if (hit && (hit.state === "Running" || hit.ready)) return hit;
      }
    } catch { /* keep trying */ }
    await Bun.sleep(1500);
  }
  return null;
}
async function uninstallExisting(): Promise<void> {
  const api = await liveAgentNames();
  const id = api.get(name);
  if (id && id !== "?") {
    const r = await fetch(`${OPENFANG_API}/api/agents/${id}/uninstall`, { method: "DELETE", signal: AbortSignal.timeout(15000) });
    console.log(`  uninstall live agent: ${r.status}`);
  }
  for (const d of [`${ESTATE_AGENTS}/${name}`, `${LIVE_AGENTS}/${name}`]) {
    if (existsSync(d)) { rmSync(d, { recursive: true }); console.log(`  removed ${d}`); }
  }
}
function atomicWrite(path: string, content: string): void {
  const tmp = path + `.tmp.${process.pid}`;
  writeFileSync(tmp, content);
  renameSync(tmp, path);
}

// ---------- main ----------
async function main() {
  console.log(`=== openfang-join: '${name}' (${fromAgent ? `clone of ${fromAgent}` : "template"}) ${dryRun ? "(DRY RUN)" : "(LIVE)"} ===\n`);

  if (rejoin && !dryRun) {
    console.log("--- --rejoin: clearing existing entries ---");
    await uninstallExisting();
  }

  const manifest = fromAgent ? buildFromClone() : buildFromTemplate();
  const toml = emitToml(manifest);
  const md = renderSystemMd();

  console.log("--- generated agent.toml ---");
  console.log(toml);
  console.log("--- validation gate ---");
  const verdicts = await validate(toml);
  let allOk = true;
  for (const v of verdicts) {
    console.log(`${v.ok ? "✓" : "✗"} ${v.id} ${v.label}: ${v.detail}`);
    if (!v.ok) allOk = false;
  }
  if (dryRun) {
    console.log(allOk ? "\nDRY-RUN VERDICT: PASS — would join" : "\nDRY-RUN VERDICT: FAIL — join REFUSED");
    process.exit(allOk ? 0 : 1);
  }
  if (!allOk) { console.log("\nGATE REFUSED: no spawn attempted, nothing written."); process.exit(1); }

  // canonical (git-tracked) + live copy, atomic
  for (const dir of [`${ESTATE_AGENTS}/${name}`, `${LIVE_AGENTS}/${name}`]) {
    mkdirSync(dir, { recursive: true });
    atomicWrite(`${dir}/agent.toml`, toml);
    atomicWrite(`${dir}/system.md`, md);
  }
  console.log(`\nwrote ${ESTATE_AGENTS}/${name}/agent.toml + system.md (canonical)`);
  console.log(`wrote ${LIVE_AGENTS}/${name}/agent.toml + system.md (live copy)`);

  // spawn: CLI primary, API fallback
  const t0 = Date.now();
  const manifestPath = `${ESTATE_AGENTS}/${name}/agent.toml`;
  let ok = await spawnViaCli(manifestPath);
  if (!ok) { console.log("CLI failed — falling back to POST /api/agents"); ok = await spawnViaApi(toml); }
  if (!ok) { console.log("SPAWN FAILED on both paths. Manifests are on disk; fix the kernel and re-run with --rejoin."); process.exit(1); }

  const live = await verifyLive();
  if (!live) { console.log(`spawn ok but '${name}' not Running within 60s — INVESTIGATE`); process.exit(1); }
  console.log(`\n✅ '${name}' LIVE — id=${live.id} state=${live.state} (${((Date.now() - t0) / 1000).toFixed(1)}s)`);

  // agent card (identity bundle, pattern #5)
  console.log("--- agent card ---");
  console.log(JSON.stringify({
    name, id: live.id, state: live.state,
    persona: manifest.persona, model: `${manifest.model.provider}/${manifest.model.model}`,
    workspace: manifest.workspace, fleet_born: true,
  }, null, 2));

  if (doCommit || doPush) {
    console.log("\n--- committing canonical manifest ---");
    const res = await $`git -C ${ESTATE} add agents/${name}/agent.toml agents/${name}/system.md && git -C ${ESTATE} commit -m ${`openfang-join: admit fleet agent '${name}' (${lane}/${task})`}`.text();
    console.log(res.text().slice(0, 300));
    if (doPush) {
      console.log("--- pushing (fetch-first, no force) ---");
      await $`git -C ${ESTATE} fetch origin main`.quiet();
      const base = (await $`git -C ${ESTATE} rev-parse origin/main`.text()).trim();
      const head = (await $`git -C ${ESTATE} rev-parse HEAD`.text()).trim();
      const merged = (await $`git -C ${ESTATE} merge-base --is-ancestor ${base} HEAD`.exitCode()) === 0;
      if (!merged) { console.log("remote moved and not our ancestor — manual merge needed, NOT pushing"); process.exit(1); }
      await $`git -C ${ESTATE} push origin HEAD:main`;
      const ref = (await $`git ls-remote origin refs/heads/main`.text()).trim().split(/\s+/)[0];
      console.log(ref === head ? `push verified: origin/main = ${ref}` : `PUSH UNVERIFIED: remote=${ref} local=${head}`);
    }
  }
}
main();
