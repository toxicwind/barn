#!/usr/bin/env bash
# pitchfork-restart — lock-aware restart for estate daemons.
#
# WHY: stock `pitchfork restart` (stop+start) is not lock-file aware. When a
# daemon's lock file outlives its holder — crash without cleanup, a child
# pitchfork lost track of, a stale staging area — the new instance
# crash-loops on the stale lock. Seen live:
#   2026-10-03  estate/squawk-relay-forward exit-3 loop: .forward.lock held
#               by pid 3830144, a child pitchfork had forgotten; manual
#               SIGTERM was the only fix.
#   2026-10-05  gatehouse hot-restart candidate died: staging Bolt DB
#               "locked by another process"; no stale-holder handling.
#
# WHAT THIS DOES (per daemon id):
#   1. snapshot the daemon's open *.lock files via /proc/<pid>/fd
#   2. pitchfork stop <id>; wait (bounded) for the PID to exit, SIGKILL on timeout
#   3. sweep each lock file:
#        - no live holder (fuser empty) -> delete the stale lock file
#        - live holder that is not the daemon -> SIGTERM the orphan holder,
#          SIGKILL on timeout, then re-check (a lock held by a stranger is
#          never left behind)
#   4. pitchfork start <id>; verify status=running
#
# SAFETY:
#   - only *.lock / *.lck paths are ever deleted; database files etc. are
#     never touched (hodos on a DB releases itself when the holder dies).
#   - only daemons named on the command line are affected.
#   - the estate `pitchfork` wrapper's estate/ guard applies (we call it).
set -uo pipefail

PITCHFORK="${PITCHFORK_BIN:-/home/toxic/estate/bin/pitchfork}"
STOP_TIMEOUT=30
KILL_TIMEOUT=10

log() { printf '[pitchfork-restart] %s\n' "$*" >&2; }
die() { log "FATAL: $*"; exit 1; }

daemon_pid() {
  "$PITCHFORK" status "$1" 2>/dev/null | awk '/^PID:/{print $2}'
}

# Print NUL-separated open *.lock/*.lck paths of a pid (regular files only).
daemon_locks() {
  local pid="$1" fd target
  [ -d "/proc/$pid/fd" ] || return 0
  for fd in "/proc/$pid/fd"/*; do
    target="$(readlink "$fd" 2>/dev/null)" || continue
    case "$target" in
      *.lock|*.lck)
        # skip deleted/special entries like " (deleted)" suffix handled below
        case "$target" in
          *"(deleted)") continue;;
        esac
        [ -f "$target" ] && printf '%s\0' "$target"
        ;;
    esac
  done
}

wait_pid_gone() {
  local pid="$1" timeout="$2" waited=0
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$waited" -ge "$timeout" ]; then return 1; fi
    sleep 1; waited=$((waited + 1))
  done
  return 0
}

# Sweep one lock file. Echoes an action summary on stdout.
sweep_lock() {
  local lock="$1" holders h
  [ -e "$lock" ] || { echo "absent $lock"; return 0; }
  holders="$(fuser "$lock" 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' || true)"
  if [ -z "$holders" ]; then
    rm -f -- "$lock" && echo "deleted-stale $lock" || echo "delete-failed $lock"
    return 0
  fi
  for h in $holders; do
    log "orphan holder pid=$h on $lock -> SIGTERM"
    kill -TERM "$h" 2>/dev/null || true
  done
  sleep 2
  for h in $holders; do
    if kill -0 "$h" 2>/dev/null; then
      log "orphan holder pid=$h survived TERM -> SIGKILL"
      kill -KILL "$h" 2>/dev/null || true
    fi
  done
  sleep 1
  holders="$(fuser "$lock" 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' || true)"
  if [ -z "$holders" ]; then
    rm -f -- "$lock" && echo "deleted-after-reap $lock" || echo "delete-failed $lock"
  else
    echo "holder-survived $lock holders=$holders"
    return 1
  fi
}

restart_one() {
  local id="$1" pid locks lockfile result rc=0
  log "=== restart $id ==="
  pid="$(daemon_pid "$id")"
  if [ -z "$pid" ] || [ "$pid" = "0" ]; then
    log "$id: no live PID (already stopped?) — sweeping nothing, starting"
  else
    log "$id: pid=$pid, snapshotting open lock files"
    locks="$(daemon_locks "$pid" | tr '\0' '\n' | sort -u)"
    if [ -n "$locks" ]; then log "$id: tracked locks:"; printf '%s\n' "$locks" | while read -r l; do log "  $l"; done; fi
    log "$id: stopping"
    "$PITCHFORK" stop "$id" >/dev/null 2>&1 || log "$id: stop returned non-zero, continuing"
    if wait_pid_gone "$pid" "$STOP_TIMEOUT"; then
      log "$id: pid=$pid exited"
    else
      log "$id: pid=$pid would not stop in ${STOP_TIMEOUT}s -> SIGKILL"
      kill -KILL "$pid" 2>/dev/null || true
      wait_pid_gone "$pid" "$KILL_TIMEOUT" || die "$id: pid=$pid unkillable, refusing to continue"
    fi
    if [ -n "$locks" ]; then
      log "$id: sweeping ${locks//$'\n'/ } for stale locks"
      printf '%s\n' "$locks" | while read -r lockfile; do
        [ -n "$lockfile" ] || continue
        result="$(sweep_lock "$lockfile")"
        log "$id: lock $result"
        case "$result" in holder-survived*) rc=1;; esac
      done
    fi
  fi
  log "$id: starting"
  "$PITCHFORK" start "$id" >/dev/null 2>&1 || die "$id: start failed"
  sleep 2
  if "$PITCHFORK" status "$id" 2>/dev/null | grep -q 'Status: running'; then
    log "$id: running"
  else
    die "$id: not running after start"
  fi
  return $rc
}

# Only run when executed, not when sourced (lets tests source the functions).
main() {
  [ $# -ge 1 ] || { echo "usage: pitchfork-restart <daemon-id> [daemon-id...]" >&2; exit 2; }
  local rc=0 id
  for id in "$@"; do
    restart_one "$id" || rc=1
  done
  exit $rc
}

if [ "${BASH_SOURCE[0]:-}" = "$0" ]; then
  main "$@"
fi
