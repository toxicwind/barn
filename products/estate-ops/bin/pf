#!/usr/bin/env bun
/**
 * pf — pitchfork config modularization tool (design B: one manifest per daemon).
 *
 *   pf migrate          split pitchfork.toml -> pitchfork.d/<name>.toml (one-time)
 *   pf build            compose pitchfork.d/ -> pitchfork.toml (in-place, guarded, atomic)
 *   pf diff             list daemons changed vs git HEAD (restart list)
 *   pf check            validate fragments + composed config, report drift
 *   pf explain <daemon> show which fragment defines a daemon and its sync state
 *
 * Source of truth: pitchfork.d/<name>.toml (one file per daemon).
 * pitchfork.toml stays the parent entrypoint — pf build rewrites ONLY its
 * [daemons.*] sections, preserving every other byte (comments, env_file,
 * [groups.*], ordering). Never hand-edit a [daemons.*] section in
 * pitchfork.toml: pf build detects it (via pitchfork.d/.hashes ancestor
 * tracking) and aborts instead of clobbering it.
 *
 * Reload semantics (verified against pitchfork 2.25.0 + the config's own
 * header): pitchfork notices new/deleted daemons via mtime; EDITING a running
 * daemon's stanza does NOT re-register it — run bin/pitchfork-restart
 * estate/<name> (use `pf diff` for the exact list).
 */
import { join, resolve, basename } from "node:path";
import { createHash } from "node:crypto";
import { readdir, mkdir } from "node:fs/promises";

const ROOT = process.env.PF_ROOT ?? process.cwd();
const PARENT = join(ROOT, "pitchfork.toml");
const DDIR = join(ROOT, "pitchfork.d");
const HASHES_FILE = join(DDIR, ".hashes");

const DAEMON_RE = /^\s*\[daemons\.([A-Za-z0-9_.-]+)\]/;

type Segment =
  | { kind: "preamble"; lines: string[] }
  | { kind: "daemon"; name: string; lines: string[] };

/** Parse a toml file into ordered segments, preserving every line byte-for-byte. */
function parseSegments(path: string, text: string): Segment[] {
  const segs: Segment[] = [];
  let cur: Segment = { kind: "preamble", lines: [] };
  segs.push(cur);
  for (const line of text.split("\n")) {
    const m = line.match(DAEMON_RE);
    if (m) {
      const name = m[1].split(".")[0];
      cur = { kind: "daemon", name, lines: [] };
      segs.push(cur);
      cur.lines.push(line);
      continue;
    }
    if (/^\s*\[/.test(line) && cur.kind === "daemon") {
      // a non-daemon section after daemons: back to preamble mode
      cur = { kind: "preamble", lines: [] };
      segs.push(cur);
    }
    cur.lines.push(line);
  }
  return segs;
}

/** Parse one fragment file -> daemon name + stanza lines. */
function parseFragment(path: string, text: string): { name: string; lines: string[] } {
  let name = "";
  const lines: string[] = [];
  let inDaemon = false;
  for (const line of text.split("\n")) {
    const m = line.match(DAEMON_RE);
    if (m) {
      const n = m[1].split(".")[0];
      if (inDaemon && n !== name) throw new Error(`${path}: more than one daemon (${name}, ${n}) — one manifest per daemon`);
      name = n; inDaemon = true;
    } else if (/^\s*\[/.test(line) && inDaemon) {
      throw new Error(`${path}: non-daemon section inside a daemon manifest — manifests hold exactly one [daemons.<name>]`);
    }
    if (inDaemon) lines.push(line);
    // lines before the first [daemons.*] are header comments: allowed, not part of the stanza
  }
  if (!name) throw new Error(`${path}: no [daemons.<name>] section found`);
  return { name, lines };
}

function normStanza(lines: string[]): string[] {
  const out = [...lines];
  while (out.length > 0 && out[out.length - 1].trim() === "") out.pop();
  return out;
}
const sha = (s: string) => createHash("sha256").update(s).digest("hex").slice(0, 16);

async function readHashes(): Promise<Record<string, string>> {
  try { return JSON.parse(await Bun.file(HASHES_FILE).text()); }
  catch { return {}; }
}
async function fragmentNames(): Promise<string[]> {
  const names: string[] = [];
  for (const e of await readdir(DDIR)) {
    if (!e.endsWith(".toml")) continue;
    const { name } = parseFragment(join(DDIR, e), await Bun.file(join(DDIR, e)).text());
    if (names.includes(name)) throw new Error(`duplicate daemon [${name}] also in ${e}`);
    names.push(name);
  }
  return names.sort();
}
function validateToml(path: string, text: string): void {
  try { Bun.TOML.parse(text); }
  catch (e: any) { throw new Error(`${path}: invalid TOML: ${e.message}`); }
}
/** Atomic write; preserves mtime when bytes are unchanged (no spurious pitchfork reload). */
async function atomicWrite(path: string, text: string): Promise<boolean> {
  let cur = "";
  try { cur = await Bun.file(path).text(); } catch {}
  if (cur === text) return false;
  const tmp = path + `.tmp.${process.pid}`;
  await Bun.write(tmp, text);
  await Bun.$`mv ${tmp} ${path}`.quiet();
  return true;
}

// ---------------- migrate ----------------
async function cmdMigrate(): Promise<void> {
  const text = await Bun.file(PARENT).text();
  validateToml(PARENT, text);
  const segs = parseSegments(PARENT, text);
  const daemons = segs.filter((s) => s.kind === "daemon") as Extract<Segment, { kind: "daemon" }>[];
  if (daemons.length === 0) throw new Error("no [daemons.*] sections found — nothing to migrate");
  await mkdir(DDIR, { recursive: true });
  const hashes: Record<string, string> = {};
  for (const d of daemons) {
    // fragments are stored normalized (no trailing blanks); the parent's
    // original trailing-blank structure is re-applied at build time, so
    // build(migrate(x)) == x byte-for-byte.
    const stanza = normStanza(d.lines).join("\n") + "\n";
    const body = `# pf fragment: [daemons.${d.name}]\n# source of truth — do not edit this stanza in pitchfork.toml (pf build overwrites it)\n\n${stanza}`;
    await Bun.write(join(DDIR, `${d.name}.toml`), body);
    hashes[d.name] = sha(stanza);
  }
  await Bun.write(HASHES_FILE, JSON.stringify(hashes, null, 1) + "\n");
  // verify: rebuild must be byte-identical to the current parent
  const rebuilt = await buildText(true);
  if (rebuilt !== text) {
    // find first divergence for the error message
    const a = text.split("\n"), b = rebuilt.split("\n");
    let i = 0;
    while (i < Math.min(a.length, b.length) && a[i] === b[i]) i++;
    throw new Error(`migration verification FAILED at line ${i + 1}:\n  orig: ${a[i]}\n  rebuilt: ${b[i]}`);
  }
  console.log(JSON.stringify({ migrated: daemons.length, fragments: DDIR, verified: "byte-identical rebuild" }));
}

// ---------------- build ----------------
/** Compose the new parent text. checkOnly=true skips the hand-edit guard (used by migrate verify). */
async function buildText(checkOnly = false): Promise<string> {
  const parentText = await Bun.file(PARENT).text();
  const segs = parseSegments(PARENT, parentText);
  const hashes = checkOnly ? {} : await readHashes();

  // load fragments: name -> normalized stanza lines
  const frags = new Map<string, string[]>();
  for (const e of await readdir(DDIR)) {
    if (!e.endsWith(".toml")) continue;
    const p = join(DDIR, e);
    const { name, lines } = parseFragment(p, await Bun.file(p).text());
    if (frags.has(name)) throw new Error(`duplicate daemon [${name}]: ${e} and another fragment`);
    frags.set(name, normStanza(lines));
  }
  const stanzaText = (lines: string[]) => lines.join("\n") + "\n";

  const parentDaemons = new Map<string, string>();
  for (const s of segs) if (s.kind === "daemon") parentDaemons.set(s.name, stanzaText(normStanza(s.lines)));

  if (!checkOnly) {
    // three-way guard: fragment vs ancestor (.hashes) vs current parent stanza
    const handEdited: string[] = [], conflicted: string[] = [];
    for (const [name, fragLines] of frags) {
      const cur = parentDaemons.get(name);
      if (cur === undefined) continue; // new daemon, handled below
      const anc = hashes[name];
      const fH = sha(stanzaText(fragLines)), cH = sha(cur);
      if (fH === cH) continue;                       // in sync
      if (anc === undefined || cH === anc) continue;  // fragment edited -> rebuild
      if (fH === anc) { handEdited.push(name); continue; } // parent hand-edited
      conflicted.push(name);                          // both changed
    }
    // daemon sections in parent with no fragment are deletions waiting to happen
    const orphaned = [...parentDaemons.keys()].filter((n) => !frags.has(n));
    if (handEdited.length > 0 || conflicted.length > 0 || orphaned.length > 0) {
      const msg = [
        handEdited.length ? `hand-edited in pitchfork.toml (move into pitchfork.d/<name>.toml): ${handEdited.join(", ")}` : "",
        conflicted.length ? `changed in BOTH pitchfork.toml and fragment (resolve by hand): ${conflicted.join(", ")}` : "",
        orphaned.length ? `in pitchfork.toml but fragment deleted (delete the section explicitly if intended): ${orphaned.join(", ")}` : "",
      ].filter(Boolean).join("\n  ");
      throw new Error(`pf build refused — source of truth is pitchfork.d/:\n  ${msg}\n  Rerun after fixing, or use --force to let fragments win.`);
    }
  }

  // rewrite daemon segments in place, preserving order, preamble bytes,
  // and each segment's original trailing-blank structure
  const out: string[] = [];
  const seen = new Set<string>();
  for (const s of segs) {
    if (s.kind === "preamble") { out.push(s.lines.join("\n")); continue; }
    const frag = frags.get(s.name);
    if (frag === undefined) { out.push(s.lines.join("\n")); continue; } // unreachable (guarded above)
    seen.add(s.name);
    const origTrail = s.lines.slice(normStanza(s.lines).length);
    out.push([...frag, ...origTrail].join("\n"));
  }
  // new daemons: append after the last segment, alphabetical, blank-separated
  const added = [...frags.keys()].filter((n) => !seen.has(n) && !parentDaemons.has(n)).sort();
  for (const n of added) out.push("", frags.get(n)!.join("\n"));
  let text = out.join("\n");
  if (!text.endsWith("\n")) text += "\n";
  validateToml("composed", text);
  return text;
}

async function cmdBuild(args: string[]): Promise<void> {
  const force = args.includes("--force");
  let text: string;
  try {
    text = await buildText(false);
  } catch (e: any) {
    if (!force) throw e;
    console.error(`warning: --force overrode guard: ${(e as Error).message.split("\n")[0]}`);
    text = await buildText(true);
  }
  const changed = await atomicWrite(PARENT, text);
  // refresh ancestor hashes to the just-built state
  const segs = parseSegments(PARENT, text);
  const hashes: Record<string, string> = {};
  for (const s of segs) if (s.kind === "daemon") hashes[s.name] = sha(normStanza(s.lines).join("\n") + "\n");
  await Bun.write(HASHES_FILE, JSON.stringify(hashes, null, 1) + "\n");
  // per-daemon change summary vs git HEAD (the restart list)
  const changedDaemons = await changedDaemonNames();
  console.log(JSON.stringify({ built: PARENT, bytes: text.length, changed, changed_daemons: changedDaemons,
    restart: changedDaemons.length ? `bin/pitchfork-restart ${changedDaemons.map((d) => `estate/${d}`).join(" ")}` : "none" }));
}

/** Daemons whose stanza differs between git HEAD and worktree parent. */
async function changedDaemonNames(): Promise<string[]> {
  const p = Bun.spawn(["git", "diff", "HEAD", "--", PARENT], { cwd: ROOT, stdout: "pipe", stderr: "pipe" });
  const out = await new Response(p.stdout).text();
  const touched = new Set<string>();
  let cur = "";
  // per-hunk state; flushed at the next @@ or EOF
  let hunkHeaders = new Set<string>(), hunkAttr: string | null = null;
  let inHunk = false;
  const flush = () => {
    for (const h of hunkHeaders) touched.add(h);
    if (hunkAttr) touched.add(hunkAttr);
    hunkHeaders = new Set<string>(); hunkAttr = null;
  };
  for (const line of out.split("\n")) {
    if (line.startsWith("@@")) { if (inHunk) flush(); inHunk = true; continue; }
    if (!inHunk) {
      const hm0 = /^[ +-]\[daemons\.([^\]]+)\]/.exec(line);
      if (hm0) cur = hm0[1].split(".")[0];
      continue;
    }
    const hm = /^[ +-]\[daemons\.([^\]]+)\]/.exec(line);
    if (hm) {
      cur = hm[1].split(".")[0];
      hunkHeaders.add(cur);
      if (line[0] === "+" || line[0] === "-") hunkAttr = cur;
      continue;
    }
    // blank +/- lines carry no attribution (they'd inherit the previous stanza)
    if ((line.startsWith("+") || line.startsWith("-")) && line.trim().length > 1
        && !line.startsWith("+++") && !line.startsWith("---") && hunkAttr === null) {
      hunkAttr = cur;
    }
  }
  if (inHunk) flush();
  return [...touched].sort();
}

// ---------------- diff ----------------
async function cmdDiff(): Promise<void> {
  const names = await changedDaemonNames();
  console.log(JSON.stringify({ changed_daemons: names,
    restart: names.length ? `bin/pitchfork-restart ${names.map((d) => `estate/${d}`).join(" ")}` : "none" }, null, 1));
}

// ---------------- check ----------------
async function cmdCheck(): Promise<void> {
  const issues: string[] = [];
  const names = await fragmentNames().catch((e: any) => { issues.push(e.message); return [] as string[]; });
  // validate each fragment parses as TOML
  for (const n of names) {
    const p = join(DDIR, `${n}.toml`);
    try { validateToml(p, await Bun.file(p).text()); } catch (e: any) { issues.push(e.message); }
  }
  // parent parses + daemon set matches fragments
  const parentText = await Bun.file(PARENT).text();
  try {
    const doc: any = Bun.TOML.parse(parentText);
    const pnames = Object.keys(doc.daemons ?? {}).sort();
    const missing = names.filter((n) => !pnames.includes(n));
    const extra = pnames.filter((n) => !names.includes(n));
    if (missing.length) issues.push(`in pitchfork.d/ but not pitchfork.toml: ${missing.join(", ")} (run pf build)`);
    if (extra.length) issues.push(`in pitchfork.toml but no fragment: ${extra.join(", ")}`);
    // groups.all removed 2026-10-18 (redundant with `pitchfork start -a`);
    // legacy drift check kept only if the group still exists
    if (doc.groups?.all?.daemons) {
      const all = new Set<string>(doc.groups.all.daemons as string[]);
      const unlisted = pnames.filter((n) => !all.has(n));
      if (unlisted.length) console.log(JSON.stringify({ note: `groups.all lists ${all.size}/${pnames.length} daemons; unlisted: ${unlisted.length}`, unlisted }));
    }
  } catch (e: any) { issues.push(`pitchfork.toml: invalid TOML: ${e.message}`); }
  if (issues.length) { console.error("check FAILED:\n- " + issues.join("\n- ")); process.exit(1); }
  console.log(JSON.stringify({ check: "ok", daemons: names.length }));
}

// ---------------- explain ----------------
async function cmdExplain(name: string): Promise<void> {
  const p = join(DDIR, `${name}.toml`);
  const fragExists = await Bun.file(p).exists();
  const hashes = await readHashes();
  const parentText = await Bun.file(PARENT).text();
  const segs = parseSegments(PARENT, parentText);
  const cur = segs.find((s) => s.kind === "daemon" && (s as any).name === name) as Extract<Segment, { kind: "daemon" }> | undefined;
  let fragStanza = "";
  if (fragExists) fragStanza = normStanza(parseFragment(p, await Bun.file(p).text()).lines).join("\n") + "\n";
  const curStanza = cur ? normStanza(cur.lines).join("\n") + "\n" : "";
  const state = !fragExists ? "no fragment" : !cur ? "fragment only (run pf build)" :
    sha(fragStanza) === sha(curStanza) ? "in sync" :
    hashes[name] === sha(curStanza) ? "fragment edited (run pf build)" :
    hashes[name] === sha(fragStanza) ? "parent hand-edited (move into fragment)" : "DIVERGED both sides";
  console.log(JSON.stringify({ daemon: name, fragment: fragExists ? p : null, state }, null, 1));
}

// ---------------- main ----------------
const [cmd, ...args] = process.argv.slice(2);
try {
  if (cmd === "migrate") await cmdMigrate();
  else if (cmd === "build") await cmdBuild(args);
  else if (cmd === "diff") await cmdDiff();
  else if (cmd === "check") await cmdCheck();
  else if (cmd === "explain" && args[0]) await cmdExplain(args[0]);
  else { console.error("usage: pf <migrate|build [--force]|diff|check|explain <daemon>>"); process.exit(2); }
} catch (e: any) {
  console.error(`pf ${cmd} failed: ${e.message}`);
  process.exit(1);
}
