#!/usr/bin/env python3
"""bin/pitchfork-reconcile -- MAPE-K reconciliation loop for pitchfork daemons.

P1 of the supervision-persistence design (~/workspace/supervision-paper-fixes/
DESIGN.md). The dominant failure class is the split brain between desired
state (pitchfork.toml) and actual state (supervisor snapshot + live
processes). This loop converges them:

  MONITOR   pitchfork.toml [daemons.*] (desired) +
            supervisor snapshot ~/.local/state/pitchfork/state.toml +
            `pitchfork ls` (registered) +
            ss -ltn / pid liveness (ground truth).
  ANALYZE   per daemon: (a) run/dir/env/port drift toml-vs-snapshot,
            (b) auto=start but not registered, (c) registered but not running,
            (d) registered but toml section deleted (orphan).
  PLAN      drift -> re-register | missing -> register+start | dead -> start |
            orphan -> evict (against INTENTIONALLY_MANUAL).
  EXECUTE   ONLY via bin/pitchfork-restart (owned wrapper). Never raw
            kill+start in one command. Never touches squawk or the bridge.
  KNOWLEDGE pitchfork.toml + logs/reconcile-ledger.jsonl (JSONL: timestamp,
            daemon, action, reason, commit SHA).

Modes: --dry-run (default): print the plan, change nothing.
       --apply: execute the plan, verify each action, append to the ledger.

Exit codes: 0 ok / nothing to do | 1 usage | 2 monitor failure (supervisor
unreachable) | 3 one or more actions failed.
"""
import argparse
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone

import tomllib

REPO = "/home/toxic/estate"
TOML = os.path.join(REPO, "pitchfork.toml")
STATE_TOML = "/home/toxic/.local/state/pitchfork/state.toml"
WRAPPER = os.path.join(REPO, "bin", "pitchfork-restart")
LOGDIR = os.path.join(REPO, "logs")
LEDGER = os.path.join(LOGDIR, "reconcile-ledger.jsonl")
LOCKFILE = "/tmp/pitchfork-reconcile.lock"
NAMESPACE = "estate"
SYSTEMD_USER_DIR = "/home/toxic/.config/systemd/user"

# --- protection: NEVER touch these, in either mode -------------------------
PROTECTED_NAME_RE = re.compile(r"squawk", re.IGNORECASE)  # any squawk process
PROTECTED_PORTS = {25147, 25135, 25204}  # squawk-ws, squawk-feed, bridge
PROTECTED_IDS = {"estate/awrawr-ws-exec"}  # live bridge daemon

# Orphan registrations (in the supervisor, no [daemons.*] toml section) that
# must NOT be evicted. Empty by default: add "estate/<name>" with a reason
# comment if a registration is intentionally kept outside the toml.
INTENTIONALLY_MANUAL = set()

SUPERVISOR_READY_TRIES = 5
SUPERVISOR_READY_WAIT_S = 2
WRAPPER_TIMEOUT_S = 300


def log(msg):
    print(f"[pitchfork-reconcile] {msg}", flush=True)


def run(cmd, timeout=30):
    """Run cmd, return (rc, stdout). Never raises on command failure."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (subprocess.TimeoutExpired, OSError) as e:
        return 127, f"<exec failed: {e}>"


def resolve_pitchfork():
    """Prefer the RUNNING supervisor's own binary (same registry view as
    `pitchfork list`), mirroring bin/pitchfork-restart's resolve_pf."""
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            continue
        if "pitchfork supervisor run" in argv:
            try:
                exe = os.readlink(f"/proc/{pid}/exe")
            except OSError:
                continue
            if exe.endswith("/pitchfork") and os.access(exe, os.X_OK):
                return exe
    home = "/home/toxic"
    for cand in (
        f"{home}/.local/share/mise/installs/pitchfork/2.25.0/pitchfork",
        f"{home}/.local/share/mise/installs/pitchfork/latest/pitchfork",
        f"{home}/.local/share/mise/shims/pitchfork",
    ):
        if os.access(cand, os.X_OK):
            return cand
    return shutil.which("pitchfork")


# --- MONITOR ----------------------------------------------------------------
def monitor():
    """Return (desired, registered, snapshots, listeners) or raise RuntimeError."""
    with open(TOML, "rb") as f:
        desired = tomllib.load(f)["daemons"]
    with open(STATE_TOML, "rb") as f:
        snapshots = tomllib.load(f)["daemons"]

    pf = resolve_pitchfork()
    if not pf:
        raise RuntimeError("no usable pitchfork binary found")

    registered = None
    for _ in range(SUPERVISOR_READY_TRIES):
        rc, out = run([pf, "ls"], timeout=15)
        if rc == 0:
            registered = {}
            for line in out.splitlines():
                parts = line.split()
                if len(parts) >= 2:
                    registered[parts[0]] = parts[1]
            break
        time.sleep(SUPERVISOR_READY_WAIT_S)
    if registered is None:
        raise RuntimeError("supervisor unreachable: `pitchfork ls` failed "
                           f"{SUPERVISOR_READY_TRIES}x")

    listeners = {}  # port -> [pids]
    rc, out = run(["ss", "-ltnp"], timeout=15)
    if rc == 0:
        for line in out.splitlines():
            m = re.search(r"\s(\S+):(\d+)\s", line)
            pids = re.findall(r"pid=(\d+)", line)
            if m and pids:
                listeners.setdefault(int(m.group(2)), []).extend(
                    int(p) for p in pids)

    systemd_managed = detect_systemd_managed()

    return desired, registered, snapshots, listeners, pf, systemd_managed


def detect_systemd_managed():
    """P3 migrations: daemons moved to systemd user units
    (estate-<name>.service). Pitchfork must never re-register/start/evict
    these -- systemd owns them now. Returns {short_name: unit_state}.

    Detection is the union of (a) unit files on disk (no DBUS needed) and
    (b) loaded units from the user manager, so a migration is caught even
    mid-flight."""
    managed = {}
    try:
        for fn in os.listdir(SYSTEMD_USER_DIR):
            m = re.fullmatch(r"estate-(.+)\.service", fn)
            if m:
                managed[m.group(1)] = "unit file present"
    except OSError:
        pass
    rc, out = run(["systemctl", "--user", "list-units", "--type=service",
                   "--all", "--no-legend", "--no-pager"], timeout=15)
    if rc == 0:
        for line in out.splitlines():
            parts = line.split()
            if not parts:
                continue
            m = re.fullmatch(r"estate-(.+)\.service", parts[0])
            if m:
                state = parts[2] if len(parts) > 2 else "loaded"
                managed[m.group(1)] = state
    return managed


def is_systemd_managed_now(short):
    """Fresh per-action check: unit file exists or unit is loaded/active."""
    if os.path.exists(os.path.join(SYSTEMD_USER_DIR,
                                    f"estate-{short}.service")):
        return True
    rc, out = run(["systemctl", "--user", "list-units", "--all",
                   "--no-legend", "--no-pager",
                   f"estate-{short}.service"], timeout=15)
    return rc == 0 and bool(out.strip())


def norm_dir(d):
    return os.path.normpath(os.path.join(REPO, os.path.expanduser(d or ".")))


def norm_ports(p):
    if p is None:
        return []
    if isinstance(p, (list, tuple)):
        return sorted(int(x) for x in p)
    return [int(p)]


def norm_env(e):
    return dict(e or {})


def desired_running(section):
    return ("start" in (section.get("auto") or [])) or bool(section.get("boot_start"))


def is_protected(name, section):
    if PROTECTED_NAME_RE.search(name):
        return "name matches squawk"
    if set(norm_ports(section.get("port"))) & PROTECTED_PORTS:
        return "port is protected (squawk/bridge)"
    if f"{NAMESPACE}/{name}" in PROTECTED_IDS:
        return "protected daemon id"
    return None


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError):
        return False


def tracked_pid(pf, daemon_id):
    rc, out = run([pf, "status", "--json", daemon_id], timeout=15)
    if rc != 0:
        return None
    try:
        return json.loads(out).get("pid")
    except (json.JSONDecodeError, AttributeError):
        return None


# --- ANALYZE ----------------------------------------------------------------
def analyze(desired, registered, snapshots, systemd_managed, listeners):
    """Return list of plan items: dict(daemon, action, reason)."""
    plan = []

    def add(daemon_id, action, reason):
        plan.append({"daemon": daemon_id, "action": action, "reason": reason})

    for name, section in sorted(desired.items()):
        did = f"{NAMESPACE}/{name}"
        prot = is_protected(name, section)
        if prot:
            add(did, "skip-protected", f"protected: {prot}")
            continue
        # P3: systemd-migrated daemons are systemd's lane now -- the pitchfork
        # registration is intentionally kept stopped as a status shim.
        if name in systemd_managed:
            add(did, "skip-systemd",
                f"systemd-managed via estate-{name}.service "
                f"({systemd_managed[name]}); pitchfork registration left stopped")
            continue
        want = desired_running(section)
        status = registered.get(did)
        snap = snapshots.get(did)

        if status is None:
            # (b) desired but never registered ("available" / missing)
            if want:
                add(did, "register-start",
                    "auto=start/boot_start desired but not registered")
            else:
                add(did, "nothing-manual", "not registered, not desired (manual)")
            continue

        # (a) config drift: toml vs supervisor snapshot
        drift = []
        if snap is None:
            drift.append("no snapshot entry")
        else:
            if (section.get("run") or "") != (snap.get("run") or ""):
                drift.append("run")
            if norm_dir(section.get("dir")) != norm_dir(snap.get("dir")):
                drift.append(f"dir (toml={norm_dir(section.get('dir'))} "
                             f"vs snap={norm_dir(snap.get('dir'))})")
            if norm_env(section.get("env")) != norm_env(snap.get("env")):
                drift.append("env")
            if norm_ports(section.get("port")) != norm_ports(snap.get("port")):
                drift.append(f"port (toml={norm_ports(section.get('port'))} "
                             f"vs snap={norm_ports(snap.get('port'))})")
        if drift:
            # Warden triage v2: an errored/disabled daemon with a live port
            # (awrawr-mcp shape) must not be blind-reregistered into EADDRINUSE,
            # and a retired def must not be reregistered at all.
            if status in ("errored", "disabled"):
                cls, detail = errored_ground_truth(name, section, status, listeners)
                if cls == "ERRORED-BUT-ALIVE":
                    add(did, "adopt-check",
                        f"supervisor={status} but {detail}; adopt binding, do NOT reregister blind")
                    continue
                if cls == "STALE-DEF":
                    add(did, "retire-review",
                        f"{detail}; retirement candidate, do NOT reregister")
                    continue
            add(did, "reregister", "config drift toml-vs-snapshot: " + ", ".join(drift))
            continue

        # (c) registered but not running -- Warden triage (lane 2026-10-23):
        # ground-truth first, so we never blind-start a port-conflicting
        # orphan (EADDRINUSE) or retry-spin a retired def.
        if status != "running":
            cls, detail = errored_ground_truth(name, section, status, listeners)
            if cls == "ERRORED-BUT-ALIVE":
                add(did, "adopt-check",
                    f"supervisor={status} but {detail}; adopt binding, do NOT blind-start")
            elif cls == "STALE-DEF":
                add(did, "retire-review",
                    f"{detail}; retirement candidate, not a restart")
            elif want:
                add(did, "start",
                    f"registered as {status}, desired running; triage={cls} ({detail})")
            else:
                add(did, "nothing-manual",
                    f"registered as {status}, not desired (manual); triage={cls}")
            continue

        add(did, "verify", "registered running, no drift; verify ground truth")

    # (d) orphans: registered under our namespace, no toml section
    for did, status in sorted(registered.items()):
        if "/" in did:
            ns, short = did.split("/", 1)
        else:
            ns, short = NAMESPACE, did
        if ns != NAMESPACE or short in desired:
            continue
        if PROTECTED_NAME_RE.search(short) or did in PROTECTED_IDS:
            add(did, "skip-protected", "orphan but protected (squawk/bridge)")
        elif short in systemd_managed:
            add(did, "skip-systemd",
                f"orphan but systemd-managed via estate-{short}.service "
                f"({systemd_managed[short]}); registration kept as status shim")
        elif did in INTENTIONALLY_MANUAL:
            add(did, "nothing-manual", "orphan but intentionally-manual allowlisted")
        else:
            add(did, "evict",
                f"registered ({status}) but no [daemons.{short}] in pitchfork.toml")

    return plan


def ground_truth_check(pf, item, desired, listeners):
    """For action=verify items: confirm the port listens or the pid is alive.
    Returns (ok: bool, detail: str)."""
    did = item["daemon"]
    name = did.split("/", 1)[1]
    section = desired.get(name, {})
    ports = norm_ports(section.get("port"))
    for port in ports:
        if listeners.get(port):
            return True, f":{port} listening (pids {listeners[port]})"
    if ports:
        return False, f"supervisor=running but nothing listening on {ports}"
    pid = tracked_pid(pf, did)
    if pid and pid_alive(pid):
        return True, f"pid {pid} alive (no port)"
    return False, f"supervisor=running but pid {pid} dead"


def errored_ground_truth(name, section, status, listeners):
    """Warden drift-watch triage for non-running daemons (lane 2026-10-23).

    Classifies against ground truth (listening ports + run-target existence)
    so the plan never blind-starts a port-conflicting orphan or retry-spins
    a retired def. Returns (class, detail); class is one of:
      ERRORED-BUT-ALIVE  port live but supervisor=errored (adopt, never start)
      STALE-DEF          run-target script missing (retire, never retry-spin)
      RUNNING-BUT-DARK   supervisor=running but port dark (verify/restart)
      ERRORED-DEAD       errored, port dark, run target present (safe to start)
      OK                 no anomaly
    """
    ports = norm_ports(section.get("port"))
    port_live = any(listeners.get(p) for p in ports) if ports else False
    run = (section.get("run") or "")
    m = re.match(r"(?:exec\s+)?(/\S+)", run)
    target = m.group(1) if m else None
    target_ok = os.path.exists(target) if target else None
    if status in ("errored", "disabled"):
        if port_live:
            return "ERRORED-BUT-ALIVE", f"port(s) {ports} listening"
        if target_ok is False:
            return "STALE-DEF", f"run target missing: {target}"
        return "ERRORED-DEAD", f"port(s) {ports} dark, run target present"
    if status == "running" and ports and not port_live:
        return "RUNNING-BUT-DARK", f"nothing listening on {ports}"
    return "OK", ""


def order_plan(plan, desired):
    """Evictions first (free ports), then re-registers, then starts in
    dependency order (best effort)."""
    rank = {"evict": 0, "reregister": 1, "register-start": 2, "start": 2}
    actionable = [p for p in plan if p["action"] in rank]
    actionable.sort(key=lambda p: rank[p["action"]])

    # topo-sort the start-like actions by `depends`
    starts = [p for p in actionable if rank[p["action"]] == 2]
    others = [p for p in actionable if rank[p["action"]] < 2]
    names = {p["daemon"].split("/", 1)[1] for p in starts}
    deps = {}
    for p in starts:
        sec = desired.get(p["daemon"].split("/", 1)[1], {})
        deps[p["daemon"]] = {f"{NAMESPACE}/{d}"
                             for d in (sec.get("depends") or []) if d in names}
    ordered, done = [], set()
    while starts:
        progressed = False
        for p in list(starts):
            blockers = deps[p["daemon"]] - done
            if not blockers:
                ordered.append(p)
                done.add(p["daemon"])
                starts.remove(p)
                progressed = True
        if not progressed:  # dependency cycle: keep remaining in place
            ordered.extend(starts)
            break
    return others + ordered


# --- EXECUTE ----------------------------------------------------------------
def commit_sha():
    rc, out = run(["git", "-C", REPO, "rev-parse", "HEAD"], timeout=10)
    return out.strip() if rc == 0 else "unknown"


def ledger_append(entry):
    os.makedirs(LOGDIR, exist_ok=True)
    with open(LEDGER, "a") as f:
        f.write(json.dumps(entry) + "\n")


def execute(plan, pf, desired, listeners):
    """Run the plan via bin/pitchfork-restart. Returns failed count."""
    failed = 0
    sha = commit_sha()
    for item in plan:
        did, action = item["daemon"], item["action"]
        if action not in ("evict", "reregister", "register-start", "start"):
            continue
        # Execute-phase guard: a P3 migration may have landed between analyze
        # and execute -- re-check systemd ownership right before acting.
        short = did.split("/", 1)[1]
        if is_systemd_managed_now(short):
            log(f"SKIP {did}: became systemd-managed since analyze "
                f"(estate-{short}.service); leaving to systemd")
            continue
        reason = item["reason"]
        cmd = [WRAPPER, did]
        if action == "reregister":
            cmd.append("--reregister")
        elif action == "evict":
            cmd.append("--evict")
        log(f"EXEC {did}: {action} -- {reason}")
        rc, out = run(cmd, timeout=WRAPPER_TIMEOUT_S)
        ok = rc == 0
        # independent verification: re-read registration + ground truth
        verify_detail = ""
        if ok:
            rc2, out2 = run([pf, "ls"], timeout=15)
            reg2 = {}
            if rc2 == 0:
                for line in out2.splitlines():
                    parts = line.split()
                    if len(parts) >= 2:
                        reg2[parts[0]] = parts[1]
            rc3, out3 = run(["ss", "-ltnp"], timeout=15)
            listeners2 = {}
            if rc3 == 0:
                for line in out3.splitlines():
                    m = re.search(r"\s(\S+):(\d+)\s", line)
                    pids = re.findall(r"pid=(\d+)", line)
                    if m and pids:
                        listeners2.setdefault(int(m.group(2)), []).extend(
                            int(p) for p in pids)
            name = did.split("/", 1)[1]
            ports = norm_ports(desired.get(name, {}).get("port"))
            if item["action"] == "evict":
                ok = did not in reg2
                verify_detail = "deregistered" if ok else "STILL REGISTERED"
            else:
                st = reg2.get(did)
                if st != "running":
                    ok, verify_detail = False, f"status={st}"
                elif ports and not any(listeners2.get(p) for p in ports):
                    ok, verify_detail = False, f"ports {ports} not listening"
                else:
                    verify_detail = (f"running, ports {ports} listening"
                                     if ports else "running (no port)")
        result = "ok" if ok else "failed"
        log(f"{'DONE' if ok else 'FAILED'} {did}: {result} {verify_detail}")
        if not ok:
            failed += 1
            log(f"wrapper output tail:\n{out[-1500:]}")
        ledger_append({
            "ts": datetime.now(timezone.utc).isoformat(),
            "daemon": did,
            "action": item["action"],
            "reason": reason,
            "commit": sha,
            "result": result,
            "verify": verify_detail,
        })
    return failed


def print_plan(plan):
    print(f"{'daemon':32} {'status-action':16} reason")
    print("-" * 100)
    counts = {}
    for p in plan:
        counts[p["action"]] = counts.get(p["action"], 0) + 1
        print(f"{p['daemon']:32} {p['action']:16} {p['reason']}")
    print("-" * 100)
    print("summary:", ", ".join(f"{a}={c}" for a, c in sorted(counts.items())))


def main():
    ap = argparse.ArgumentParser(description="MAPE-K pitchfork reconciler")
    ap.add_argument("--apply", action="store_true",
                    help="execute the plan (default is --dry-run)")
    ap.add_argument("--dry-run", action="store_true",
                    help="print the plan, change nothing (default)")
    args = ap.parse_args()
    dry_run = not args.apply

    if not os.access(WRAPPER, os.X_OK):
        log(f"FATAL: wrapper not executable: {WRAPPER}")
        return 1

    # single-flight: boot unit and post-commit hook must never overlap
    lock = open(LOCKFILE, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("another reconcile is already running; skipping (idempotent)")
        return 0

    try:
        desired, registered, snapshots, listeners, pf, systemd_managed = monitor()
    except RuntimeError as e:
        log(f"FATAL monitor: {e}")
        return 2

    log(f"monitor: {len(desired)} desired, {len(registered)} registered, "
        f"{len(snapshots)} snapshots, {len(listeners)} ports listening, "
        f"systemd-managed=[{', '.join(sorted(systemd_managed)) or 'none'}], "
        f"mode={'dry-run' if dry_run else 'APPLY'}")

    plan = analyze(desired, registered, snapshots, systemd_managed, listeners)

    # resolve ground-truth verifies (read-only, runs in both modes)
    for p in plan:
        if p["action"] == "verify":
            ok, detail = ground_truth_check(pf, p, desired, listeners)
            if ok:
                p["action"] = "ok-verified"
                p["reason"] = detail
            else:
                p["action"] = "start"
                p["reason"] = f"ground-truth desync: {detail}"

    ordered = order_plan(plan, desired)

    if dry_run:
        print_plan(plan)
        return 0

    failed = execute(ordered, pf, desired, listeners)
    if failed:
        log(f"APPLY finished with {failed} failed action(s)")
        return 3
    log("APPLY finished: all actions ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
