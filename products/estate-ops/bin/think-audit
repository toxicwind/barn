#!/usr/bin/env python3
"""think-audit — measure reasoning tokens vs tool calls per assistant turn.

The hidden reasoning trace has no editor, no rule file, no budget and no
feedback signal. This instrument makes its cost visible the same way
health-check.sh makes a squatted port visible.

A turn = one assistant message (possibly several thinking blocks) plus the
tool_use blocks it emitted. Ratio = thinking tokens / tool calls. A turn with
600 thinking tokens and 1 bash call is a defect, not a style.

Usage:
  think-audit [session.jsonl or session_dir ...]  # default: newest for CWD
  think-audit --all                              # every session under root
  think-audit --top N                            # worst N turns (default 10)
  think-audit --json                             # machine-readable

Tokenization: o200k_harmony via estate `tok` (~/.local/bin/tok), offline
cached. Falls back to chars/4 and says so.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
from dataclasses import dataclass, field

SESSIONS_ROOT = os.path.expanduser(
    os.environ.get(
        "TAU_SESSIONS_ROOT",
        "/home/toxic/estate/config/tau/agent/sessions",
    )
)
TOK = os.path.expanduser(os.environ.get("TOK_BIN", "~/.local/bin/tok"))

# Self-talk markers: re-plans that arrive back at the prior plan.
NOOP_MARKERS = (
    "actually,",
    "wait,",
    "let me be efficient",
    "keep momentum",
    "no careful",
    "on second thought",
    "i could also",
    "alternatively, i",
    "hmm, but",
    "but actually",
)


@dataclass
class Turn:
    """One assistant turn: its thinking blocks and the tool calls they won."""

    index: int
    timestamp: str
    thinking: str = ""
    tool_calls: int = 0
    tool_names: list = field(default_factory=list)
    thinking_tokens: int = 0
    noop_phrases: list = field(default_factory=list)

    @property
    def ratio(self) -> float:
        """Thinking tokens per tool call; inf when the turn produced none."""
        if self.tool_calls == 0:
            return float("inf")
        return self.thinking_tokens / self.tool_calls


def tok_count(text: str) -> tuple[int, bool]:
    """Count o200k tokens. Returns (count, used_real_tokenizer)."""
    if not text:
        return 0, True
    try:
        out = subprocess.run(
            [TOK, "-"], input=text.encode(), capture_output=True, timeout=30
        )
        if out.returncode == 0:
            n = int(out.stdout.decode().strip())
            if n > 0:
                return n, True
    except Exception:
        pass
    return max(1, len(text) // 4), False


def iter_session_files(paths: list[str], want_all: bool) -> list[str]:
    """Resolve *.jsonl session transcripts (skipping internal __advisor)."""
    def collect(root: str) -> list[str]:
        found = []
        for dirpath, _dirs, files in os.walk(root):
            for f in files:
                if f.endswith(".jsonl") and not f.startswith("__"):
                    found.append(os.path.join(dirpath, f))
        return found

    if want_all:
        return sorted(collect(SESSIONS_ROOT), key=os.path.getmtime, reverse=True)

    if paths:
        out = []
        for p in paths:
            if os.path.isdir(p):
                out.extend(
                    os.path.join(p, f)
                    for f in sorted(os.listdir(p))
                    if f.endswith(".jsonl") and not f.startswith("__")
                )
            elif p.endswith(".jsonl"):
                out.append(p)
        return out

    sessions = sorted(collect(SESSIONS_ROOT), key=os.path.getmtime, reverse=True)
    cwd = os.getcwd()
    for s in sessions:
        try:
            with open(s) as fh:
                for line in fh:
                    try:
                        rec = json.loads(line)
                    except Exception:
                        continue
                    if rec.get("type") == "session" and rec.get("cwd") == cwd:
                        return [s]
        except OSError:
            continue
    return sessions[:1]


def parse_session(path: str) -> list[Turn]:
    """Extract per-turn thinking text and tool-call counts, then tokenize.

    Tool calls are not `tool_use` blocks in this harness: they appear as
    separate `custom` records with customType `tool_execution_start`, emitted
    after the assistant message that produced them. Attribute each to the
    most recent assistant turn.
    """
    turns: list[Turn] = []
    current: Turn | None = None
    with open(path) as fh:
        for line in fh:
            try:
                rec = json.loads(line)
            except Exception:
                continue
            rtype = rec.get("type")
            if rtype == "custom" and rec.get("customType") == "tool_execution_start":
                if current is not None:
                    current.tool_calls += 1
                    current.tool_names.append(
                        (rec.get("data") or {}).get("toolName", "?")
                    )
                continue
            if rtype != "message":
                continue
            msg = rec.get("message") or {}
            if msg.get("role") != "assistant":
                continue
            content = msg.get("content")
            if not isinstance(content, list):
                continue

            turn = Turn(index=len(turns), timestamp=rec.get("timestamp", "?"))
            parts: list[str] = []
            for block in content:
                if not isinstance(block, dict):
                    continue
                if block.get("type") == "thinking":
                    parts.append(block.get("thinking") or "")
            turn.thinking = "\n".join(parts)
            low = " ".join(turn.thinking.lower().split())
            for marker in NOOP_MARKERS:
                if marker in low:
                    turn.noop_phrases.append(marker)
            turns.append(turn)
            current = turn

    for t in turns:
        count, _real = tok_count(t.thinking)
        t.thinking_tokens = count
    return turns


def report(turns: list[Turn], path: str, top: int, as_json: bool,
           real_tok: bool) -> None:
    total_think = sum(t.thinking_tokens for t in turns)
    total_calls = sum(t.tool_calls for t in turns)
    no_calls = [t for t in turns if t.tool_calls == 0]
    noop_turns = [t for t in turns if t.noop_phrases]

    if as_json:
        print(json.dumps({
            "session": path,
            "tokenizer": "o200k_harmony" if real_tok else "chars/4 fallback",
            "turns": [{
                "index": t.index,
                "thinking_tokens": t.thinking_tokens,
                "tool_calls": t.tool_calls,
                "ratio": None if t.tool_calls == 0 else round(t.ratio, 1),
                "tools": t.tool_names,
                "noop_markers": t.noop_phrases,
            } for t in turns],
            "totals": {
                "thinking_tokens": total_think,
                "tool_calls": total_calls,
                "turns": len(turns),
                "turns_without_tool_calls": len(no_calls),
                "noop_marker_turns": len(noop_turns),
            },
        }, indent=1))
        return

    print(f"session: {path}")
    print(f"tokenizer: {'o200k_harmony' if real_tok else 'chars/4 FALLBACK'}")
    print(f"turns: {len(turns)}  thinking_tokens: {total_think}  "
          f"tool_calls: {total_calls}")
    if total_calls:
        print(f"session ratio: {total_think / total_calls:.1f} "
              "thinking tokens per tool call")
    print(f"turns with zero tool calls: {len(no_calls)}")
    print(f"turns with self-talk no-op markers: {len(noop_turns)}")
    print()
    ranked = sorted(turns, key=lambda t: (t.tool_calls == 0,
                                          -t.thinking_tokens))
    print(f"top {top} turns by thinking volume:")
    for t in ranked[:top]:
        ratio = "inf" if t.tool_calls == 0 else f"{t.ratio:.0f}:1"
        tools = ",".join(t.tool_names) or "(none)"
        first = " ".join(t.thinking.split())[:70]
        print(f"  #{t.index:<3} {t.thinking_tokens:>5} think / "
              f"{t.tool_calls} call ({ratio:>6})  tools={tools}")
        if t.noop_phrases:
            print(f"        no-op markers: {', '.join(t.noop_phrases)}")
        if first:
            print(f"        opens: {first}")


def main(argv: list[str]) -> int:
    top = 10
    as_json = False
    want_all = False
    paths: list[str] = []
    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg == "--json":
            as_json = True
        elif arg == "--all":
            want_all = True
        elif arg == "--top":
            i += 1
            top = int(argv[i])
        else:
            paths.append(arg)
        i += 1

    sessions = iter_session_files(paths, want_all)
    if not sessions:
        print("think-audit: no sessions found", file=sys.stderr)
        return 1

    real_tok = True
    for s in sessions:
        turns = parse_session(s)
        report(turns, s, top, as_json, real_tok)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
