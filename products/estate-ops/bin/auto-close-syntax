#!/usr/bin/env bun
/**
 * auto-close-syntax — Agentic & Structural Syntax Auto-Closer / Healer
 *
 * Grounded in 4 primary agentic & parser references:
 *   1. pi-ai / earendil-works tool_call repair pipeline:
 *      Strips premature markdown fences around tool calls, repairs truncated JSON payloads.
 *   2. jsonmend / typemeld:
 *      Single-pass auto-closer for truncated objects, arrays, and unquoted values.
 *   3. Strata / Niko1221 tool_call_recovery:
 *      Recovers explicit `<tool_call>` / `<think>` wrappers left unclosed by streaming tokens.
 *   4. CodeMirror closebrackets & Tree-Sitter scanner.c:
 *      Stack-based LIFO delimiter pairing with context lookahead.
 */

import { readFileSync, writeFileSync, existsSync } from "node:fs";

export interface RepairResult {
  repaired: string;
  appended: string;
  recoveredToolCall: boolean;
  unclosedFences: boolean;
  unclosedDelimiters: string[];
}

export function repairAgenticStream(raw: string): RepairResult {
  let text = raw.trim();
  let recoveredToolCall = false;
  let unclosedFences = false;

  // 1. Agentic Tool Call & Markdown Fence Unwrapping
  // Fix models emitting ```json { "arguments": ... } ``` inside tool wrappers
  const fencedToolMatch = text.match(/^```(?:json)?\s*([\s\S]*?)\s*```$/i);
  if (fencedToolMatch) {
    text = fencedToolMatch[1].trim();
  }

  // Count unclosed code fences
  const fenceMatches = text.match(/```/g);
  if (fenceMatches && fenceMatches.length % 2 !== 0) {
    unclosedFences = true;
  }

  // 2. Unclosed Agentic XML Wrappers (<think>, <tool_call>)
  const tags = ["think", "tool_call", "function_call", "output"];
  const appendedTags: string[] = [];
  for (const tag of tags) {
    const openCount = (text.match(new RegExp(`<${tag}[^>]*>`, "g")) || []).length;
    const closeCount = (text.match(new RegExp(`</${tag}>`, "g")) || []).length;
    if (openCount > closeCount) {
      appendedTags.push(`</${tag}>`);
      if (tag === "tool_call" || tag === "function_call") {
        recoveredToolCall = true;
      }
    }
  }

  // 3. Delimiter Stack Scan (Ignoring string bodies and comments)
  const stack: { char: string; expected: string }[] = [];
  const PAIRS: Record<string, string> = { "(": ")", "[": "]", "{": "}" };
  const CLOSERS: Record<string, string> = { ")": "(", "]": "[", "}": "{" };

  let inSingle = false;
  let inDouble = false;
  let inBacktick = false;
  let escaped = false;

  for (let i = 0; i < text.length; i++) {
    const char = text[i];

    if (escaped) {
      escaped = false;
      continue;
    }
    if (char === "\\") {
      escaped = true;
      continue;
    }

    if (char === "'" && !inDouble && !inBacktick) {
      inSingle = !inSingle;
      continue;
    }
    if (char === '"' && !inSingle && !inBacktick) {
      inDouble = !inDouble;
      continue;
    }
    if (char === "`" && !inSingle && !inDouble) {
      inBacktick = !inBacktick;
      continue;
    }

    if (inSingle || inDouble || inBacktick) continue;

    if (char in PAIRS) {
      stack.push({ char, expected: PAIRS[char] });
    } else if (char in CLOSERS) {
      if (stack.length > 0 && stack[stack.length - 1].expected === char) {
        stack.pop();
      }
    }
  }

  // Close open quotes
  let quoteCloser = "";
  if (inDouble) quoteCloser += '"';
  if (inSingle) quoteCloser += "'";
  if (inBacktick) quoteCloser += "`";

  // Close LIFO delimiters
  const delimiterClosers = stack.reverse().map((s) => s.expected).join("");

  // Close open markdown fence
  const fenceCloser = unclosedFences ? "\n```" : "";

  // Combine appended sequence
  const appended = quoteCloser + delimiterClosers + fenceCloser + appendedTags.join("");
  const repaired = text + appended;

  return {
    repaired,
    appended,
    recoveredToolCall,
    unclosedFences,
    unclosedDelimiters: stack.map((s) => s.char),
  };
}

if (import.meta.main) {
  const args = process.argv.slice(2);
  if (args.length === 0 || args.includes("--help") || args.includes("-h")) {
    console.log(`
auto-close-syntax — Agentic & Structural Syntax Auto-Closer

Capabilities:
  • Auto-closes truncated JSON tool calls and stream outputs
  • Recovers unclosed <tool_call>, <think>, <function_call> tags
  • Balances unclosed (), [], {} in strict LIFO order
  • Strips or heals broken code fences (\`\`\`)

Usage:
  auto-close-syntax <file> [--write]
  auto-close-syntax -e 'streamed snippet' [--json]
`);
    process.exit(0);
  }

  let text = "";
  let targetFile = "";
  const shouldWrite = args.includes("--write");
  const asJson = args.includes("--json");

  if (args[0] === "-e" && args[1]) {
    text = args[1];
  } else if (existsSync(args[0])) {
    targetFile = args[0];
    text = readFileSync(targetFile, "utf8");
  } else {
    text = args.filter((a) => !a.startsWith("--")).join(" ");
  }

  const result = repairAgenticStream(text);

  if (asJson) {
    console.log(JSON.stringify(result, null, 2));
    process.exit(0);
  }

  if (result.appended.length > 0) {
    if (shouldWrite && targetFile) {
      writeFileSync(targetFile, result.repaired, "utf8");
      console.log(`✅ Fixed: Appended '${result.appended}' to ${targetFile}`);
    } else {
      console.log(`⚠️ Agentic auto-close triggered!`);
      if (result.recoveredToolCall) console.log("   • Healed unclosed tool-call / function-call wrapper");
      if (result.unclosedFences) console.log("   • Closed open markdown code fence");
      console.log(`Appended fix: '${result.appended}'`);
      console.log(`--- Repaired Output ---\n${result.repaired}`);
    }
  } else {
    console.log("✅ Balanced: Zero unclosed delimiters or agentic tags detected.");
  }
}
