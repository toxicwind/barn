#!/usr/bin/env python3
"""secretsmith-env — dump secretsmith keyring as shell export lines.

Single D-Bus session, bulk read (~1.5s for 200+ items, vs 340ms/item via
subprocess). Source with:  set -a; eval "$(secretsmith-env)"; set +a
Skips items whose label is not a valid shell identifier (human-named items
like "Brevo API Key" are retrievable via secretsmith get --label instead).
"""
import os
import re
import sys
import secretstorage

VALID = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")

if "DBUS_SESSION_BUS_ADDRESS" not in os.environ:
    bus_path = f"/run/user/{os.getuid()}/bus"
    if os.path.exists(bus_path):
        os.environ["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus_path}"

try:
    conn = secretstorage.dbus_init()
except Exception:
    sys.exit(1)
coll = secretstorage.get_default_collection(conn)
for item in coll.get_all_items():
    label = item.get_label()
    if not VALID.match(label):
        continue
    try:
        secret = item.get_secret().decode("utf-8")
    except Exception:
        continue
    if not secret:
        continue
    safe = "'" + secret.replace("'", "'\\''") + "'"
    print(f"{label}={safe}")
