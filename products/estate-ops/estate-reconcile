#!/usr/bin/env bash
# bin/estate-reconcile — event-driven estate drift reconciler (WS2, ferrous-warden).
#
# Compares DECLARED intent (deploy/manifest.yaml) against RUNTIME state
# (file shas, symlink targets, running process binaries via /proc) and reports
# drift. The warden is ALERT-ONLY — it never restores anything (Chris 2026-09-30).
#
# Usage:
#   estate-reconcile check [--manifest F]     read-only drift report; exit 1 on drift
#   estate-reconcile --apply [--manifest F]   DISABLED — always refuses, exit 2
#   estate-reconcile watch  [--manifest F]    inotify event loop (event-driven; no timers)
#   estate-reconcile proc-audit               declared vs /proc exe for the daemons
#
# Environment:
#   ESTATE_ROOT   estate worktree (default /home/toxic/estate)
#   SQUAWK_ROOT   squawk root (default /home/toxic/.squawk-bus/squawk-root);
#                 unset/no-fleet-dir => squawk alerts no-op (sandbox-safe)
#
# Restore rules: there are none anymore. Restoration is HARD-DISABLED in this
# workstream (Chris 2026-09-30: "shouldn't be restoring anything"). The warden
# is alert-only on every path — autonomous watch, manual --apply, everything.
# Configs are REPORT-ONLY in this workstream — the tree is shared with other
# crews' live WIP.
set -euo pipefail

ESTATE_ROOT="${ESTATE_ROOT:-/home/toxic/estate}"
MANIFEST_DEFAULT="$ESTATE_ROOT/deploy/manifest.yaml"
LOG_DIR="$ESTATE_ROOT/log"
AUDIT_DIR="$LOG_DIR/drift-audit"
LOCK_FILE="$LOG_DIR/.estate-reconcile.lock"
# Self-identity (2026-09-30, torque): the watcher must never watch itself.
SELF_BIN="$(readlink -f "$0" 2>/dev/null || echo "$0")"
mkdir -p "$AUDIT_DIR"

_log()  { printf '%s %s\n' "$(date -Iseconds)" "$*" >> "$LOG_DIR/estate-reconcile.log"; }
_out()  { printf '%s\n' "$*"; }

# yote-side squawk publish, hodos-protected seq allocation (borrowed from
# ops/openfang-health/openfang-health.sh's proven pattern).
#
# DEDUPE (2026-09-30, slate): the 9/25 flood (~70 posts in ~90s) was publisher
# sickness — identical alerts re-posted on every watch-loop pass while drift
# persisted. _squawk now coalesces: identical (title,body) within
# DEDUPE_WINDOW_S posts once and counts the rest; on state change (or window
# expiry with pending repeats) a single summary goes out first. The warden is
# NEVER silent — repeats always surface as a summary. State lives in $LOG_DIR,
# guarded by its own hodos; lock order is always dedupe-lock -> publish-lock.
DEDUPE_WINDOW_S=600
DEDUPE_STATE="$LOG_DIR/.squawk-dedupe.state"

# Durable seq allocation: the ranch seq_alloc.py serializes read-modify-write
# on its own hodos and never returns a seq at/below a previously allocated
# one. Degraded forward path = max+1 when the allocator is absent (races under
# concurrency, but posts rather than dies).
_seq_next() {
  local root="$1" ch="$2" sa=""
  for _sa in "$ESTATE_ROOT/projects/range/ranch/squawk/seq_alloc.py" \
             /home/toxic/pens/ranch/squawk/seq_alloc.py; do
    [ -f "$_sa" ] && sa="$_sa" && break
  done
  if [ -n "$sa" ]; then
    python3 "$sa" "$root" "$ch" 2>/dev/null && return 0
  fi
  python3 -c "
import re, glob
ms=[re.match(r'(\d+)-', f.split('/')[-1]) for f in glob.glob('$root/$ch/*.md')]
ns=[int(m.group(1)) for m in ms if m]
print((max(ns)+1) if ns else 1)"
}

_squawk_raw() {
  local title="$1" body="$2"
  local root="${SQUAWK_ROOT:-/home/toxic/.squawk-bus/squawk-root}"
  [ -d "$root/fleet" ] || return 0
  (
    flock -x 200
    local seq
    seq="$(_seq_next "$root" fleet)"
    {
      # NOTE (2026-09-21 fig-audit): the opening --- fence is REQUIRED. The
      # squawk feed's identity parser rejects bare frontmatter, and the
      # unsigned-body fallback can only serve bodies from fenced files --
      # without it the message renders as an empty row (seq 12712-12717).
      printf -- '---\nseq: %s\nfrom: ferrous-warden\nto: all\nchannel: fleet\nts: %s\nstatus: discussion\ntitle: %s\n---\n' \
        "$seq" "$(date -Iseconds)" "$title"
      printf '%s\n' "$body"
    } > "$root/fleet/${seq}-estate-reconcile.md"
  ) 200>"$LOCK_FILE" || true
}

_squawk() {
  local title="$1" body="$2"
  local now hash lhash="" lts=0 cnt=0 ltitle=""
  now="$(date +%s)"
  hash="$(printf '%s\x00%s' "$title" "$body" | sha256sum | cut -d' ' -f1)"
  (
    flock -x 200
    if [ -f "$DEDUPE_STATE" ]; then
      IFS='|' read -r lhash lts cnt ltitle < "$DEDUPE_STATE" 2>/dev/null || true
    fi
    cnt="${cnt:-0}"; lts="${lts:-0}"
    if [ "$hash" = "$lhash" ] && [ $((now - lts)) -lt "$DEDUPE_WINDOW_S" ]; then
      # repeat: count it, stay silent — the summary speaks for the flood
      printf '%s|%s|%s|%s\n' "$hash" "$now" "$((cnt+1))" "$title" > "$DEDUPE_STATE"
      _log "SQUAWK-DEDUPE coalesced repeat #$((cnt+1)): $title"
      exit 0
    fi
    # state change (or window expired): flush pending repeats as ONE summary,
    # then post the new alert. Never silent, never a flood.
    if [ "$cnt" -gt 0 ] && [ -n "$lhash" ]; then
      _squawk_raw "estate-reconcile: $cnt repeat(s) coalesced" \
        "The preceding alert ('${ltitle:-$title}') repeated $cnt time(s) within the dedupe window and was coalesced into this summary instead of $cnt fleet posts. Latest distinct alert follows."
    fi
    printf '%s|%s|%s|%s\n' "$hash" "$now" 0 "$title" > "$DEDUPE_STATE"
    _squawk_raw "$title" "$body"
  ) 200>"$DEDUPE_STATE.lock"
}

# Parse manifest.yaml into rows: name<TAB>key<TAB>value (bash 4+, fixed schema).
# Sets global arrays: NAMES[], and assoc BIN[path], BIN[sha256], ...
declare -a NAMES=()
declare -A BIN=()
_parse_manifest() {
  local mf="$1" name="" key val line
  NAMES=(); BIN=()
  local in_bin=0
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" =~ ^binaries: ]]; then
      in_bin=1; continue
    fi
    if [[ "$line" =~ ^[a-z_][a-z_]*: ]]; then
      in_bin=0; continue
    fi
    if [ "$in_bin" -eq 0 ]; then continue; fi
    if [[ "$line" =~ ^[[:space:]][[:space:]]([a-zA-Z0-9_-]+):[[:space:]]*$ ]]; then
      name="${BASH_REMATCH[1]}"; NAMES+=("$name"); continue
    fi
    # value class: everything up to an optional closing quote (no \r escape in ERE)
    if [[ "$line" =~ ^[[:space:]][[:space:]][[:space:]][[:space:]]([a-zA-Z0-9_]+):[[:space:]]*\"?([^\"]*)\"?[[:space:]]*$ ]]; then
      key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
      BIN["$name/$key"]="$val"
    fi
  done < "$mf"
}
_field() { printf '%s' "${BIN["$1/$2"]:-}"; }

_SHA_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/estate-reconcile-sha.cache"
# _sha: content hash with mtime+size cache for large files (>100MB).
# (2026-10-03: estate-reconcile watch re-hashed the 881MB openfang on every
# inotify event, pinning a CPU. Large files now hash once until mtime/size change.)
_sha() {
  local f="$1" size mtime h key cached
  size="$(stat -c%s "$f" 2>/dev/null || echo 0)"
  if [ "$size" -gt 104857600 ]; then
    mtime="$(stat -c%Y "$f" 2>/dev/null || echo 0)"
    key="$f|$size|$mtime"
    cached="$(grep -F "$key|" "$_SHA_CACHE" 2>/dev/null | cut -d'|' -f4 | tail -1)"
    if [ -n "$cached" ]; then printf '%s\n' "$cached"; return 0; fi
    h="$(sha256sum "$f" 2>/dev/null | awk '{print $1}')"
    mkdir -p "$(dirname "$_SHA_CACHE")" 2>/dev/null
    printf '%s|%s|%s|%s\n' "$f" "$size" "$mtime" "$h" >> "$_SHA_CACHE"
    printf '%s\n' "$h"
    return 0
  fi
  sha256sum "$1" 2>/dev/null | awk '{print $1}'
}

# Is path under one of the manifest runtime_paths? -> exempt from drift.
_exempt() {
  local path="$1" rp
  rp="$(awk '/^runtime_paths:/{f=1;next}/^[a-z_]+:/{f=0} f && /^[[:space:]]*-/{sub(/^[[:space:]]*-[[:space:]]*/,""); print}' "$MANIFEST")"
  local p
  while IFS= read -r p; do
    if [ -z "$p" ]; then continue; fi
    case "${path%/}" in "$p"*|"$p") return 0;; esac
  done <<< "$rp"
  return 1
}

# --- drift checks -----------------------------------------------------------
# Prints DRIFT lines "name|kind|detail"; returns count.
_check_binaries() {
  local mf="$1" drift=0 name path want got real
  for name in "${NAMES[@]}"; do
    path="$(_field "$name" path)"; want="$(_field "$name" sha256)"
    if _exempt "$path"; then continue; fi
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
      _out "DRIFT $name missing (declared path absent: $path)"; drift=$((drift+1)); continue
    fi
    if [ -L "$path" ]; then
      real="$(readlink -f "$path" 2>/dev/null || true)"
      [ -e "$real" ] || { _out "DRIFT $name dangling-symlink ($path -> $real)"; drift=$((drift+1)); continue; }
      got="$(_sha "$real")"
    else
      got="$(_sha "$path")"
    fi
    if [ "$got" != "$want" ]; then
      gp="$(_field "$name" git_path)"
      if [ -n "$gp" ]; then
        headsha="$(git -C "$ESTATE_ROOT" show "HEAD:$gp" 2>/dev/null | sha256sum | cut -d" " -f1)"
        if [ -n "$headsha" ] && [ "$got" = "$headsha" ]; then
          _out "STALE $name manifest-stale (live matches git HEAD ${got:0:12}.., manifest wants ${want:0:12}..)"
          _check_running "$name" "$path" "$got" || drift=$((drift+1))
          continue
        fi
      fi
      _out "DRIFT $name sha-mismatch (declared ${want:0:12}.. live ${got:0:12}..)"; drift=$((drift+1))
    fi
    _check_running "$name" "$path" "$want" || drift=$((drift+1))
  done
  return "$drift"
}

# Running-process check: the process running the declared artifact must match it.
# Handles native binaries (compare /proc/pid/exe) and interpreted daemons
# (python3 scripts: exe is the interpreter, so compare the script from cmdline).
_check_running() {
  local name="$1" path="$2" want="$3"
  local daemon exe exesha cmdline
  daemon="$(_field "$name" daemon)"
  if [ -z "$daemon" ]; then return 0; fi
  for pid in $(pgrep -f "$path" 2>/dev/null || true); do
    if [ "$pid" = "$$" ]; then continue; fi
    if [ ! -d "/proc/$pid" ]; then continue; fi
    exe="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
    if [ -z "$exe" ]; then continue; fi
    exesha="$(_sha "$exe")"
    if [ "$exesha" = "$want" ]; then continue; fi           # native: exe IS the artifact
    cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
    case "$cmdline" in
      *"$path"*)
        # interpreted: exe is the interpreter, script is the artifact
        if [ "$(_sha "$path")" = "$want" ]; then continue; fi
        ;;
    esac
    _out "DRIFT $name running (pid $pid exe=$exe sha ${exesha:0:12}.. != declared ${want:0:12}..)"
    return 1
  done
  return 0
}

cmd_check() {
  local mf="$1"
  _parse_manifest "$mf"
  local out n=0
  out="$(_check_binaries "$mf")" || n=$?
  if [ "$n" -gt 0 ]; then
    printf '%s\n' "$out"
    _log "CHECK drift=$n"
    return 1
  fi
  _out "OK: all ${#NAMES[@]} declared binaries match (files + running)"
  return 0
}

cmd_proc_audit() {
  local mf="$1"
  _parse_manifest "$mf"
  local name path daemon exe exesha
  for name in "${NAMES[@]}"; do
    path="$(_field "$name" path)"; daemon="$(_field "$name" daemon)"
    printf '== %s (daemon %s)\n  declared: %s\n' "$name" "${daemon:-none}" "$path"
    for pid in $(pgrep -f "$path" 2>/dev/null || true); do
      exe="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
      exesha="$(_sha "$exe")"
      printf '  pid %-7s exe=%s sha=%s\n' "$pid" "$exe" "${exesha:0:16}.."
    done
  done
}

# --- restore: HARD-DISABLED --------------------------------------------------
# Chris 2026-09-30: "ferrious warden is broke and shouldn't be restoring
# anything it's being idiotic". Every restore path is dead code that refuses.
# cmd_apply keeps the --apply CLI token ONLY so stale call sites fail LOUDLY
# (exit 2) instead of silently doing nothing. The warden is alert-only,
# period — drift is reported by `check` and the watch loop; restoring is a
# human decision (rebuild, bless, or trusted copy by hand).
cmd_apply() {
  local mf="$1"
  _log "APPLY-REFUSED: --apply invoked but all restore paths are disabled by Chris's order"
  _out "REFUSED: estate-reconcile --apply is disabled (Chris 2026-09-30 — the warden restores NOTHING)."
  _out "Drifted binaries are reported by 'check' and the watch loop; restoration is a human decision."
  return 2
}

# Former restore helpers: kept as fail-closed refuse stubs so ANY code path
# that reaches them (present or future) cannot restore. No install/ln/mv of
# drifted binaries exists anywhere in this file anymore.
_restore_from_copy() {
  _log "RESTORE-REFUSED: _restore_from_copy $1 (restore paths disabled)"
  _out "REFUSED: restore disabled — the warden restores nothing."
  return 2
}

_restore_from_git() {
  _log "RESTORE-REFUSED: _restore_from_git $1 (restore paths disabled)"
  _out "REFUSED: restore disabled — the warden restores nothing."
  return 2
}

# --- event-driven watch -----------------------------------------------------
# inotify on the build/bin dirs + manual invocation. No timers: every pass is
# event-triggered, plus a circuit breaker (not a poller) that rate-limits
# alert bursts. Restoration is DISABLED on this path too (Chris 2026-09-30).
cmd_watch() {
  local mf="$1"
  _parse_manifest "$mf"
  command -v inotifywait >/dev/null || { _out "FATAL: inotifywait not found"; exit 1; }
  local dirs=() d name path
  for name in "${NAMES[@]}"; do
    path="$(_field "$name" path)"
    d="$(dirname "$path")"
    case " ${dirs[*]} " in *" $d "*) : ;; *) dirs+=("$d") ;; esac
  done
  # Degraded-watch (2026-10-02, warden): declared paths can go stale (estate
  # migration moved ranch). A missing dir must not kill the whole watch loop --
  # skip it LOUDLY and keep watching the rest. The manifest (declared intent)
  # is untouched here; the stale declared path still shows as drift in `check`.
  local live_dirs=() missing=()
  for d in "${dirs[@]}"; do
    if [ -d "$d" ]; then live_dirs+=("$d"); else missing+=("$d"); fi
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    _log "WATCH-DEGRADED missing watch dirs: ${missing[*]} (declared paths stale?)"
    _squawk "estate-reconcile watch DEGRADED" "Watch directories missing - declared manifest paths stale after the estate migration: ${missing[*]}. Watch continues on: ${live_dirs[*]}. Manifest declared-path fix needs a human/oracle decision (rebuild, bless, or trusted copy)."
  fi
  _log "watch started on: ${live_dirs[*]}"
  _out "watching: ${live_dirs[*]}"
  [ "${#live_dirs[@]}" -eq 0 ] && { _out "FATAL: no watch directories exist"; exit 1; }
  inotifywait -m -q -e modify,attrib,move,delete,moved_to,moved_from,create \
    --format '%w%f %e' "${live_dirs[@]}" 2>/dev/null | while read -r evpath ev; do
    sleep 1   # debounce burst writes
    # Self-exclusion (2026-09-30, torque): events on the warden's own binary,
    # log, ledger, locks, or dedupe state are deploys/housekeeping, not drift.
    # Skipping them here stops a self-edit from tripping the breaker.
    case "$evpath" in
      "$SELF_BIN"|"$LOG_DIR"/*) continue ;;
    esac
    if cmd_check "$mf" >/dev/null 2>&1; then continue; fi
    # circuit breaker: >5 restores in trailing 60 min => alert-only
    local recent cutoff
    cutoff="$(date -d '60 minutes ago' -Iseconds 2>/dev/null || date -u -d '60 minutes ago' +%Y-%m-%dT%H:%M:%S%z)"
    recent="$(awk -v c="$cutoff" '$1 > c && /RESTORED/{n++} END{print n+0}' "$LOG_DIR/estate-reconcile.log" 2>/dev/null || echo 0)"
    if [ "${recent:-0}" -gt 5 ]; then
      _log "BREAKER-OPEN drift on $evpath ($ev): alert-only"
      # Dedupe key (2026-09-30, torque): the raw inotify kind ($ev) varies per
      # burst (CREATE/MODIFY/DELETE on one deploy) and used to defeat the
      # (title,body) dedupe, flooding the fleet. Body is now canonical per path;
      # repeats coalesce inside DEDUPE_WINDOW_S (600s). Restores are disabled
      # on every path — this branch is a pure alert burst-guard now.
      _squawk "estate-reconcile BREAKER OPEN" "Drift detected on $evpath but alert burst limit exceeded (circuit breaker). The warden restores nothing — manual intervention required."
      continue
    fi
    # Auto-restore DISABLED by Chris 2026-09-30 ("shouldn't be restoring
    # anything"): the watch loop is alert-only now. Drift gets logged +
    # squawked; a human (or the oracle) decides rebuild/bless/trusted-copy.
    _log "ALERT-ONLY drift on $evpath ($ev): auto-restore disabled"
    _squawk "estate-reconcile drift (alert-only)" "Drift detected on $evpath ($ev). Auto-restore is disabled by Chris's order - manual decision required (rebuild, bless, or trusted copy)."
  done
}

# --- main -------------------------------------------------------------------
MANIFEST="$MANIFEST_DEFAULT"
CMD="check"
while [ $# -gt 0 ]; do
  case "$1" in
    check|--apply|watch|proc-audit) CMD="${1#--}" ;;
    --manifest) MANIFEST="$2"; shift ;;
    *) _out "usage: $0 [check|--apply|watch|proc-audit] [--manifest FILE]"; exit 1 ;;
  esac
  shift
done
[ -f "$MANIFEST" ] || { _out "FATAL: manifest not found: $MANIFEST"; exit 1; }

case "$CMD" in
  check)      cmd_check "$MANIFEST" ;;
  apply)      cmd_apply "$MANIFEST" ;;
  watch)      cmd_watch "$MANIFEST" ;;
  proc-audit) cmd_proc_audit "$MANIFEST" ;;
esac
