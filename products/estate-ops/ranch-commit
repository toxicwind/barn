#!/bin/sh
# ranch-commit — the lane commit path for toxicwind/ranch.
# Pry, 2026-10-19. See RANCH-WORKTREES.md in the ranch root.
#
# Why: lanes committing to main in the canonical checkout
# (/home/toxic/pens/ranch — the runtime tree) produced the twin-commit
# divergence cycle: parallel local mains, cherry-pick equivalence proofs,
# three reconciles in one day. The fix is structural: every lane commits
# from its OWN worktree, and origin/main is the single serialization
# point — pushes are fast-forward-only, so a second pusher rebases
# instead of forking history.
#
# Usage (inside /home/toxic/kite/worktrees/ranch-<lane>):
#   git add <files>
#   ranch-commit -m "message"        (extra args pass to git commit)
#
# Flow: commit -> fetch -> rebase onto origin/main -> push HEAD:main.
# (Commit first: rebase refuses a dirty index, and staging first is the
# caller's whole point.) On a non-fast-forward rejection (origin moved
# mid-push) it rebases and retries exactly once, then reports.
# It never forces.
set -e
top=$(git rev-parse --show-toplevel)
case "$top" in
    */kite/worktrees/ranch-*) ;;
    *) echo "ranch-commit: run inside a lane worktree (/home/toxic/kite/worktrees/ranch-<lane>), not $top" >&2; exit 2 ;;
esac
git commit "$@"
git fetch origin
if ! git rebase origin/main; then
    echo "ranch-commit: rebase conflict — resolve it in this worktree (git rebase --continue), then: git push origin HEAD:main" >&2
    exit 1
fi
if ! git push origin HEAD:main; then
    echo "ranch-commit: origin moved — rebasing and retrying once" >&2
    git fetch origin
    git rebase origin/main
    git push origin HEAD:main
fi
git ls-remote origin main
