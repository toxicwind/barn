#!/usr/bin/env bun
/**
 * pitchfork-compose — the parent's composer for per-project daemon ownership (D2).
 *
 * The parent COMPOSES; it does not own daemon stanzas. Each project owns
 * <project>/pitchfork.d/<daemon>.toml (one daemon per file); this tool merges
 * them with the parent's own preamble/groups into the single pitchfork.toml
 * that pitchfork 2.25.0 reads. Lineage: systemd drop-in dirs (sorted files,
 * whole-config reload) + supervisord two-phase (parse+validate all, diff,
 * restart only changed) — see docs/pitchfork-modularization/.
 *
 *   bin/pitchfork-compose [--root DIR] [--check] [--out FILE]
 *                         [--running RUN.json --attribution ATTR.json]
 *                         [--diff OLD.toml]
 *
 *   --check       validate only: parse everything, fail closed on conflicts
 *   --out FILE    atomic write of composed output (GENERATED header prepended)
 *   --running     orphan detection: daemons pitchfork runs that no project
 *   --attribution   claims, attributed to their last-known project
 *   --diff OLD    per-daemon diff of OLD.toml vs the freshly composed config
 *                 (drives targeted restarts: only changed/added/removed)
 *
 * Exit codes: 0 ok · 1 error/usage · 3 OWNERSHIP CONFLICT (fail-closed).
 * The composer never writes pitchfork.toml on failure; callers must only
 * replace the live file on exit 0 (atomic rename keeps pitchfork's hot-reload safe).
 */

const ROOT_DEFAULT = "/home/toxic/estate";

function arg(name: string): string | undefined {
  const i = process.argv.indexOf(name);
  return i >= 0 && i + 1 < process.argv.length ? process.argv[i + 1] : undefined;
}
function flag(name: string): boolean { return process.argv.includes(name); }

const root = arg("--root") ?? ROOT_DEFAULT;
const checkOnly = flag("--check");
const outPath = arg("--out");
const runningPath = arg("--running");
const attribPath = arg("--attribution");
const diffPath = arg("--diff");

// --- minimal TOML/FS helpers (self-contained; no relative imports) ---
const parseToml = (text: string): any => Bun.TOML.parse(text);

async function sortedTomls(dir: string): Promise<string[]> {
  const names: string[] = [];
  for await (const e of new Bun.Glob("*.toml").scan({ cwd: dir, absolute: true })) names.push(e);
  return names.sort();
}

async function atomicWrite(path: string, text: string): Promise<void> {
  const tmp = `${path}.tmp.${process.pid}`;
  await Bun.write(tmp, text);
  await Bun.$`mv ${tmp} ${path}`.quiet();
}

function deepEqual(a: any, b: any): boolean {
  if (a === b) return true;
  if (typeof a !== typeof b) return false;
  if (a === null || b === null) return a === b;
  if (Array.isArray(a) || Array.isArray(b)) {
    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
    return a.every((v, i) => deepEqual(v, b[i]));
  }
  if (typeof a === "object") {
    const ka = Object.keys(a).sort();
    const kb = Object.keys(b).sort();
    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) return false;
    return ka.every((k) => deepEqual(a[k], b[k]));
  }
  return false;
}

function daemonDiff(oldP: any, newP: any): { changed: string[]; added: string[]; removed: string[] } {
  const od = oldP.daemons ?? {};
  const nd = newP.daemons ?? {};
  const changed: string[] = [], added: string[] = [], removed: string[] = [];
  for (const n of Object.keys(nd)) {
    if (!(n in od)) added.push(n);
    else if (!deepEqual(od[n], nd[n])) changed.push(n);
  }
  for (const n of Object.keys(od)) if (!(n in nd)) removed.push(n);
  const og = oldP.groups ?? {}, ng = newP.groups ?? {};
  if (!deepEqual(og, ng)) changed.push("(groups)");
  if (oldP.env_file !== newP.env_file) changed.push("(env_file)");
  return { changed: changed.sort(), added: added.sort(), removed: removed.sort() };
}

/**
 * An ARCHIVED manifest claims no daemons.
 *
 * The estate keeps deprecated copies of a manifest next to its replacement
 * (ranch/range/pitchfork.d/range-ui.toml says "DEPRECATED: moved to
 * /home/toxic/estate/pitchfork.d/range-ui.toml — kept as an archive; do not
 * edit"). Those archives are not claims. Reading them as claims made a moved
 * daemon look like an OWNERSHIP CONFLICT and the compose failed closed, so
 * the live config could not be regenerated at all. An archive is marked either
 * by filename (*.deprecated.toml) or by a leading DEPRECATED comment.
 */
function isArchivedManifest(path: string, text: string): boolean {
  if (path.endsWith(".deprecated.toml")) return true;
  return /^\s*#\s*DEPRECATED\b/m.test(text);
}

// --- registry ---
interface Proj { key: string; manifest: string; kind?: string }
let reg: any;
try {
  reg = parseToml(await Bun.file(`${root}/projects.toml`).text());
} catch (e: any) {
  console.error(`ERROR: cannot read ${root}/projects.toml: ${e.message}`);
  process.exit(1);
}
const projects: Proj[] = reg.project ?? [];
if (!projects.length) {
  console.error(`ERROR: no [[project]] entries in ${root}/projects.toml`);
  process.exit(1);
}

// --- collect: daemon name -> owning project; project -> ordered file texts ---
// Files are concatenated as ORIGINAL TEXT (comments preserved — the live
// config's comments are incident documentation). Deterministic: registry order,
// files lexical within a project.
const owned = new Map<string, string>(); // daemon -> project key
const service = new Map<string, { dir: string; run: string; project: string }>(); // daemon -> where it runs
const projectFiles = new Map<string, string[]>(); // key -> file texts in order

for (const p of projects) {
  const mpath = `${root}/${p.manifest}`;
  let files: string[] = [];
  if (p.kind === "dir") {
    try {
      files = await sortedTomls(mpath);
    } catch {
      console.error(`ERROR: project '${p.key}' manifest dir missing: ${mpath}`);
      process.exit(1);
    }
    if (!files.length) console.error(`warn: project '${p.key}' has no *.toml in ${mpath}`);
  } else {
    const f = Bun.file(mpath);
    if (!(await f.exists())) {
      console.error(`ERROR: project '${p.key}' manifest missing: ${mpath}`);
      process.exit(1);
    }
    files = [mpath];
  }
  const texts: string[] = [];
  for (const f of files) {
    let t: string;
    try {
      t = await Bun.file(f).text();
    } catch (e: any) {
      console.error(`ERROR: cannot read ${f}: ${e.message}`);
      process.exit(1);
    }
    if (isArchivedManifest(f, t)) {
      console.error(`skip: ${f} is an archived manifest — it claims no daemons`);
      continue;
    }
    let parsed: any;
    let names: string[];
    try {
      parsed = parseToml(t);
      names = Object.keys(parsed.daemons ?? {});
    } catch (e: any) {
      console.error(`ERROR: ${f} does not parse: ${e.message}`);
      process.exit(1);
    }
    if (!names.length) {
      console.error(`warn: ${f} declares no [daemons.*] — skipped`);
      continue;
    }
    for (const n of names) {
      if (owned.has(n)) {
        console.error(
          `OWNERSHIP CONFLICT: daemon '${n}' claimed by both '${owned.get(n)}' and '${p.key}'. ` +
          `Exactly one project may own a daemon — resolve in the owning projects.`
        );
        process.exit(3);
      }
      owned.set(n, p.key);
      const d = parsed.daemons?.[n] ?? {};
      service.set(n, { dir: String(d.dir ?? ""), run: String(d.run ?? ""), project: p.key });
    }
    texts.push(t.trimEnd() + "\n");
  }
  projectFiles.set(p.key, texts);
}

// --- duplicate service identity ---------------------------------------------
// Two DIFFERENT daemon ids that point at the SAME service (same dir + same
// run command) are the same daemon wearing two names. The live registry
// carried exactly that: 'estate-stream-broker' (running) and
// 'estate-scripts-stream-broker' (available) — one dir, one run command, one
// port 25215, two ids, because a rename had changed the id in one place and
// not the other. A daemon id conflict (one id, two projects) is caught above;
// this catches the other direction, and it fails closed the same way.
{
  const byService = new Map<string, string[]>();
  for (const [name, info] of service) {
    if (!info.dir || !info.run) continue;
    const key = `${info.dir}\u0000${info.run}`;
    const arr = byService.get(key) ?? [];
    arr.push(name);
    byService.set(key, arr);
  }
  for (const [key, names] of byService) {
    if (names.length < 2) continue;
    const [dir, run] = key.split("\u0000");
    console.error(
      `DUPLICATE SERVICE: daemons ${names.sort().join(" + ")} are the same service ` +
      `(dir=${dir} run=${run}). One id is a stale copy — a partial rename or a ` +
      `copied manifest. Keep exactly one; the compose fails closed on it.`
    );
    process.exit(3);
  }
}

// --- orphan detection ---
if (runningPath) {
  let running: string[];
  try {
    running = JSON.parse(await Bun.file(runningPath).text());
  } catch (e: any) {
    console.error(`ERROR: cannot read running list ${runningPath}: ${e.message}`);
    process.exit(1);
  }
  let attrib: Record<string, string> = {};
  if (attribPath) {
    try {
      attrib = JSON.parse(await Bun.file(attribPath).text());
    } catch (e: any) {
      console.error(`ERROR: cannot read attribution ${attribPath}: ${e.message}`);
      process.exit(1);
    }
  }
  const orphans = running
    .filter((n) => !owned.has(n))
    .map((n) => ({ daemon: n, last_project: attrib[n] ?? "(unknown)" }))
    .sort((a, b) => (a.daemon < b.daemon ? -1 : 1));
  console.log(JSON.stringify({ orphan_count: orphans.length, orphans }, null, 2));
  process.exit(0);
}

if (checkOnly) {
  console.log(`OK: ${owned.size} daemons across ${projects.length} projects, no ownership conflicts`);
  process.exit(0);
}

// --- compose ---
async function composeText(): Promise<string> {
  let parent: string;
  try {
    parent = (await Bun.file(`${root}/parent.toml`).text()).trimEnd();
  } catch (e: any) {
    console.error(`ERROR: cannot read ${root}/parent.toml: ${e.message}`);
    process.exit(1);
  }
  const out: string[] = [parent, ""];
  for (const p of projects) {
    const texts = projectFiles.get(p.key) ?? [];
    if (!texts.length) continue;
    let count = 0;
    for (const [, k] of owned) if (k === p.key) count++;
    out.push(`# ---- project: ${p.key} (${count} daemon${count === 1 ? "" : "s"}) ----`);
    for (const t of texts) {
      out.push(t.trimEnd());
      out.push("");
    }
  }
  return out.join("\n");
}

const composed = await composeText();

if (diffPath) {
  let oldText: string;
  try {
    oldText = await Bun.file(diffPath).text();
  } catch (e: any) {
    console.error(`ERROR: cannot read ${diffPath}: ${e.message}`);
    process.exit(1);
  }
  const d = daemonDiff(parseToml(oldText), parseToml(composed));
  console.log(JSON.stringify(d, null, 2));
  process.exit(0);
}

const GENERATED_HEADER = [
  "# GENERATED by estate/bin/pitchfork-compose — DO NOT EDIT.",
  "# Edit the per-project sources instead: <project>/pitchfork.d/<daemon>.toml",
  "# Recompose: bin/pitchfork-compose --out pitchfork.toml",
  "",
].join("\n");

if (outPath) {
  await atomicWrite(outPath, GENERATED_HEADER + composed);
  console.error(`wrote ${outPath}: ${owned.size} daemons across ${projects.length} projects`);
} else {
  process.stdout.write(composed);
}
