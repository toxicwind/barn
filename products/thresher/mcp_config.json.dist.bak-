{
 "activity_cleanup_interval_min": 60,
 "activity_max_records": 100000,
 "activity_max_response_size": 65536,
 "activity_max_size_mb": 256,
 "activity_retention_days": 90,
 "allow_server_add": true,
 "allow_server_remove": true,
 "api_key": "REDACTED-use-MCPPROXY_API_KEY-env",
 "call_tool_timeout": "5m0s",
 "check_server_repo": true,
 "code_execution_max_tool_calls": 100,
 "code_execution_pool_size": 30,
 "code_execution_timeout_ms": 600000,
 "data_dir": "/home/toxic/.mcpproxy",
 "debug_search": false,
 "disable_management": false,
 "docker_isolation": {
  "cpu_limit": "1.0",
  "default_images": {
   "bash": "alpine:3.18",
   "binary": "alpine:3.18",
   "cargo": "rust:1.75-slim",
   "composer": "php:8.2-cli-alpine",
   "gem": "ruby:3.2-alpine",
   "go": "golang:1.21-alpine",
   "node": "node:22",
   "npm": "node:22",
   "npx": "node:22",
   "php": "php:8.2-cli-alpine",
   "pip": "ghcr.io/astral-sh/uv:python3.13-bookworm-slim",
   "pipx": "ghcr.io/astral-sh/uv:python3.13-bookworm-slim",
   "python": "ghcr.io/astral-sh/uv:python3.13-bookworm-slim",
   "python3": "ghcr.io/astral-sh/uv:python3.13-bookworm-slim",
   "ruby": "ruby:3.2-alpine",
   "rustc": "rust:1.75-slim",
   "sh": "alpine:3.18",
   "uvx": "ghcr.io/astral-sh/uv:python3.13-bookworm-slim",
   "yarn": "node:22"
  },
  "enable_cache_volume": true,
  "enabled": false,
  "log_max_files": "3",
  "log_max_size": "100m",
  "memory_limit": "512m",
  "mode": "none",
  "network_mode": "bridge",
  "registry": "docker.io",
  "timeout": "30s"
 },
 "docker_recovery": {
  "enabled": false,
  "notify_on_failure": false,
  "notify_on_retry": false,
  "notify_on_start": false,
  "notify_on_success": false,
  "persistent_state": false
 },
 "enable_code_execution": true,
 "enable_prompts": true,
 "enable_socket": true,
 "environment": {
  "allowed_system_vars": [
   "PATH",
   "HOME",
   "TMPDIR",
   "TEMP",
   "TMP",
   "SHELL",
   "TERM",
   "LANG",
   "USER",
   "USERNAME",
   "XDG_CONFIG_HOME",
   "XDG_DATA_HOME",
   "XDG_CACHE_HOME",
   "XDG_RUNTIME_DIR",
   "LC_ALL",
   "LC_CTYPE",
   "LC_NUMERIC",
   "LC_TIME",
   "LC_COLLATE",
   "LC_MONETARY",
   "LC_MESSAGES",
   "LC_PAPER",
   "LC_NAME",
   "LC_ADDRESS",
   "LC_TELEPHONE",
   "LC_MEASUREMENT",
   "LC_IDENTIFICATION",
   "DOCKER_HOST",
   "DOCKER_CONTEXT",
   "DOCKER_CONFIG",
   "DOCKER_CERT_PATH",
   "DOCKER_TLS_VERIFY",
   "NVM_DIR",
   "ASDF_DIR",
   "PYENV_ROOT",
   "VOLTA_HOME",
   "HOMEBREW_PREFIX",
   "COLIMA_HOME",
   "HYPRLAND_INSTANCE_SIGNATURE",
   "CONTEXT7_API_KEY"
  ],
  "custom_vars": {
   "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
  },
  "enhance_path": true,
  "inherit_system_safe": true
 },
 "forward_proxy_env": true,
 "health_check_interval": "15s",
 "init_timeout": "2m0s",
 "instructions": "You are talking to MCPProxy, a smart MCP proxy. Use retrieve_tools to search for tools before assuming a capability is missing. Use describe_tool to fetch full schemas for compact results. Use call_tool_read / call_tool_write / call_tool_destructive with intent to execute. Tool names are in the form serverName:toolName.",
 "intent_declaration": {
  "strict_server_validation": true
 },
 "listen": "127.0.0.1:25127",
 "logging": {
  "compress": true,
  "enable_console": true,
  "enable_file": true,
  "filename": "main.log",
  "json_format": true,
  "level": "warn",
  "max_age": 90,
  "max_backups": 20,
  "max_size": 100
 },
 "max_result_size_chars": 1000000,
