      "c0c1",
      "bidi",
      "zero_width"
    ],
    "max_redactions": 500
  },
  "output_validation": {
    "mode": "strict",
    "max_bytes": 20971520,
    "max_depth": 256,
    "missing_structured_content": "warn"
  },
