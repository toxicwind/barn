      "enabled": true,
      "protocol": "http",
      "endpoint": "localhost:4318",
      "sample_rate": 0.8
    }
  },
  "output_sanitisation": {
    "spotlight_untrusted": true,
    "response_action": "spotlight",
    "strip_control_chars": true,
    "strip_classes": [
