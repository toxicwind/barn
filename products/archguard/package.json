{
  "name": "archguard-backend",
  "version": "1.0.0",
  "description": "Pre-merge architectural guardian with deterministic FalkorDB graph engine and episodic memory",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "dev:backend": "tsx src/server.ts",
    "dev:client": "npm --prefix client run dev",
    "dev:all": "concurrently -n \"BACKEND,CLIENT\" -c \"cyan,magenta\" \"tsx src/server.ts\" \"npm --prefix client run dev\"",
    "build:client": "npm --prefix client run build",
    "seed": "tsx src/db/seed.ts",
    "seed:estate": "tsx src/scripts/seedEstate.ts",
    "verify": "tsx src/scripts/verifyBackbone.ts",
    "verify:phase2": "tsx src/scripts/verifyPhase2.ts",
    "test": "npm run verify:phase2"
  },
  "keywords": [
    "falkordb",
    "graph",
    "architecture-decision-records",
    "knowledge-graph",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "falkordb": "^6.8.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun-types": "^1.4.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
