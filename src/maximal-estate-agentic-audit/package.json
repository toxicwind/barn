{
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun-types": "^1.4.4"
  },
  "name": "maximal-estate-agentic-audit",
  "version": "18.1.14",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test --coverage",
    "local": "bun run src/local-audit.ts",
    "lint": "bunx biome check src/ tests/",
    "build": "bun build src/index.ts --outdir=dist --minified",
    "audit": "bun run src/index.ts --all --precheck --parquet output/repo-audit.parquet"
  },
  "dependencies": {
    "parquetjs-lite": "^0.8.7"
  }
}
