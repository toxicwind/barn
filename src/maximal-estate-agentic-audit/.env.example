# GitHub API
GITHUB_TOKEN=ghp_your_token_here
GITHUB_USER=toxicwind
GITHUB_PER_PAGE=100

# Output
OUTPUT_DIR=./output
OUTPUT_PARQUET=./repo-audit.parquet
OUTPUT_CSV=./repo-audit.csv

# Bun detection
CHECK_BUN=true
PRIVACY_THRESHOLD=0

# Rate limiting
REQUEST_DELAY_MS=200
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3

# Streaming
STREAM_BATCH_SIZE=50
STREAM_WINDOW_MS=5000
