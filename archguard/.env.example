# FalkorDB Connection Settings
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=archguard_brain
FALKORDB_PASSWORD=

# App Settings
PORT=4000
NODE_ENV=development

# LLM Providers (Optional: Paste your own Gemini, OpenRouter, or OpenAI API key here,
# or configure keys directly in the Command Center UI modal.
# NOTE: If left empty, ArchGuard's built-in deterministic heuristic fallback takes over
# automatically—so you can run and audit the entire workflow offline with zero crashes!)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
