# de-submoduled standalone peer clones (referenced not owned)
/flatbread/
/nativelink/
/rosec/
/weave/
/weave-sub/

# runtime/cache artifacts - never commit
__pycache__/
*.pyc
.cache/
.agent-orchestration/
tmp-reaper/
node_modules/
*.db-shm
*.db-wal

# peer products: referenced not owned, auto-ignored (submoduleless doctrine)
/products/
/archive/

# Keys & secrets — never commit
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.keyring
*.secret
.env
.env.*
!*.example
