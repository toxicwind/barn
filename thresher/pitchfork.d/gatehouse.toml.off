# ranch/barn/gatehouse — project-owned daemon manifest. Source of truth for 'gatehouse'.
# Owned by the ranch/barn/gatehouse project; the parent only composes it.





[daemons.gatehouse]
health_http = { url = "http://127.0.0.1:25127/health", interval = "30s", timeout = "5s", retries = 3 }
# no `port` field: pitchfork pre-check false-conflicts with tailscaled SNI on
# 100.72.199.93:25127 (gatehouse barn-move reconciliation, 2026-10-23).
# gatehouse-serve.ts self-heals: bootstraps gitignored mcp_config.json from .dist
# when missing, injects secrets from secretsmith/~/.secrets (direct-run crash-loops
# without it). This manifest is DISABLED (suffix .off); authoritative daemon
# config lives in /home/toxic/estate/pitchfork.toml under [daemons.gatehouse].
run = "exec /home/toxic/estate/ranch/range/bin/gatehouse-serve.ts"
dir = "/home/toxic/pens/barn/gatehouse"
mise = false
retry = true
ready_http = "http://127.0.0.1:25127/health"
auto = ["start"]
