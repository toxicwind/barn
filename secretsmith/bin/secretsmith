#!/usr/bin/env bash
# secretsmith launcher — mesh project, PATH install target.
# Symlink ~/.local/bin/secretsmith -> this file. Resolves through symlinks so
# the mesh script is found whether invoked directly or via the symlink.
# Picks the first python3 that actually has dbus-python + cryptography
# (mise-managed dirs can shadow python3 with a bare interpreter).
MESH_SCRIPT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/secretsmith.py"
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
fi
for py in /usr/bin/python3 python3; do
  if command -v "$py" >/dev/null 2>&1 \
     && "$py" -c "import dbus, cryptography" 2>/dev/null; then
    exec "$py" "$MESH_SCRIPT" "$@"
  fi
done
echo "secretsmith: no python3 with dbus-python + cryptography found" >&2
exit 1
