# ports.env — the estate port allocation (SSOT)
#
# Referenced by:
#   ssot/forge.jsonc            -> ../ports.env
#   ssot/blackbird/*.jsonc      -> ../../ports.env
#   products/blackbird/AGENTS.md
#
# Rule: every estate service lives in 25xxx. Never invent a port outside that
# range. When you add a service, add its line here in the same commit.
#
# Format: NAME=port   (# comment)
#
# This file is deliberately incomplete: it lists only allocations that were
# verified against a live listener or a checked-in config on 2026-11-16.
# Ports observed listening but not yet attributed are listed at the bottom
# under "unattributed" — do not assign them to a service until you know.

# ── blackbird (GitHub/MCP search) ────────────────────────────────────────────
BLACKBIRD_API=25112
BLACKBIRD_MCP=25113
BLACKBIRD_FRONTEND=25114

# ── thresher (MCP gateway) ───────────────────────────────────────────────────
THRESHER_MCP=25127

# ── mimetite (model router: tau/kappa/hermes lanes) ──────────────────────────
MIMETITE_ROUTER=25193

# ── doorbell (OAuth edge, front of owntv provider) ───────────────────────────
DOORBELL_OAUTH_EDGE=25210

# ── owntv (Xtream provider gateway on the PC) ────────────────────────────────
# Was 8081 until 2026-11-16. 8081 sat outside 25xxx and collided with
# unrelated dev servers. Do not reintroduce it.
OWNTV_PROVIDER=25818

# ── unattributed (observed listening 2026-11-16, owner unknown) ──────────────
# 25109 25155 25157 25196 25202 25204 25212 25250 25252 25270 25271 25310
# 25218 is free.