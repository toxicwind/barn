# --- daemon-local port names (set in pitchfork.toml [daemons.*] env tables) ---
# ${} is not expanded in run lines; these are set per-daemon in env tables
# and listed here so the numeric SSOT still sees every port in use.
WS_EXEC_PORT=25204  # daemon-local; [daemons.awrawr-ws-exec] env; consumed by bridge/awrawr_ws_exec.py
# owner: cuttinggate (the guard plane in front of herd :25100 and hodos :25193;
# quarantine + circuit breaker + credential rotation + winner ledger).
# 25200 is the value the daemon actually binds: pitchfork.d/cuttinggate.toml sets
# CUTTINGGATE_PORT=25200  # legacy name (ex-atlas gateway)
# 25192, which nothing reads — the daemon never sources ports.env, so the "SSOT"
# disagreed with the only port that serves. Keep these three in lockstep:
#   cuttinggate/pitchfork.d/cuttinggate.toml  (supplies the env)
#   cuttinggate/src/config.ts:113             (reads CUTTINGGATE_PORT; fallback 25194)
#   this file                                 (documents it)
CUTTINGGATE_PORT=25200  # legacy name (ex-atlas gateway)
CHALCOPYRITE_PORT=25200  # canonical router name (geode pen product)

