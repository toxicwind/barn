#!/usr/bin/env python3
"""
cron-trust-monitor: autonomous cron reliability watchdog + reactive remediator.

The platform lies: status="succeeded" for vetoed, overlap-skipped, and no-op runs.
Three days of vetoed backups looked "healthy" because everything said "succeeded".

This monitor:
1. Reads recent cron runs (JSONL on stdin: job_id, status, result_summary,
   error_text, ts, run_id)
2. Classifies each HONESTLY from result_summary, never from status alone
3. Excludes non-terminal records (running/queued) from trust math entirely
4. Tracks durable per-job state (watermarks) so consecutive-veto detection is
   not bounded by the sample window
5. Emits machine-actionable remediation hints; the scheduled worker body acts
   on them (stagger colliding jobs, lengthen intervals) instead of only paging

Honest classes: genuine, vetoed, overlap-skip, coalesced, quota-deferred,
                 no-op, failed, timeout, ambiguous
Non-terminal (running/queued/scheduled): excluded from trust math, counted
separately.

Exit codes: 0=healthy, 1=issues found (see output), 2=monitor error
"""

import json
import os
import sys
import tempfile
from collections import defaultdict
from datetime import datetime, timezone, timedelta

# --- classification patterns (forensic ground truth, 2026-09-19) ---
VETO_PATTERNS = [
    "did not pass the scheduled-task safety review",
    "safety review",
    "vetoed",
]
SKIP_PATTERNS = [
    "already running and concurrency.overlap=skip",
    "another run was active",
]
COALESCE_PATTERNS = [
    "scheduled_occurrence_coalesced",
]
NOOP_PATTERNS = [
    "skipped heartbeat because",
    "no-op",
    "noop",
    "did nothing",
    "nothing to do",
]

# Jobs that must never be vetoed/skipped silently
CRITICAL_JOBS = ["backup", "health", "cell-backup"]

# Only terminal records enter trust-rate math. Anything else is telemetry noise.
TERMINAL_STATUSES = {"succeeded", "failed", "cancelled", "timeout"}

LEDGER_PATH = os.path.expanduser("~/workspace/fleet-ping/cron-trust-ledger.jsonl")
STATE_PATH = os.path.expanduser("~/workspace/fleet-ping/cron-trust-state.json")
STATE_RECENT_KEEP = 20


def classify_run(run):
    """Return (honest_status, reason).

    honest_status is None for non-terminal records: they are excluded from
    trust math, never counted as genuine/failed/ambiguous.
    """
    status = (run.get("status") or "").strip()
    summary = run.get("result_summary") or ""
    error = run.get("error_text") or ""
    s_low = summary.lower()
    e_low = error.lower()

    if status == "failed":
        return ("failed", (error[:120] or summary[:120] or "no error text"))
    if status == "timeout":
        return ("timeout", "worker exceeded execution timeout")
    if status == "cancelled":
        if any(p in e_low or p in s_low for p in COALESCE_PATTERNS):
            return ("coalesced", "scheduler coalesced overlapping occurrence")
        return ("ambiguous", f"cancelled: {(error[:100] or summary[:100] or 'no detail')}")
    if status not in TERMINAL_STATUSES:
        # running, queued, scheduled, ... : not evidence of anything yet
        return (None, f"non-terminal status={status or '?'} excluded from trust math")

    # status == "succeeded": the summary carries the truth, not the badge
    if any(p in s_low for p in VETO_PATTERNS):
        return ("vetoed", "safety review blocked execution")
    if any(p in s_low for p in SKIP_PATTERNS):
        return ("overlap-skip", "another run already active")
    if "quota" in s_low and ("defer" in s_low or "guard" in s_low):
        return ("quota-deferred", summary[:120])
    if any(p in s_low for p in NOOP_PATTERNS):
        return ("no-op", summary[:120])
    if not summary.strip():
        # A succeeded run with no summary is NOT genuine: no evidence of work.
        return ("ambiguous", "succeeded with null/empty summary - cannot verify work")
    return ("genuine", summary[:120])


def is_critical(job_id):
    job_lower = (job_id or "").lower()
    return any(crit in job_lower for crit in CRITICAL_JOBS)


def parse_ts(ts_str):
    if not ts_str:
        return None
    try:
        dt = datetime.fromisoformat(str(ts_str).replace("Z", "+00:00"))
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt
    except Exception:
        return None


def atomic_write_text(path, text):
    """Write file atomically (temp + rename). Raises on failure."""
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def load_state():
    try:
        with open(STATE_PATH) as f:
            st = json.load(f)
        if isinstance(st, dict) and isinstance(st.get("jobs"), dict):
            return st
    except FileNotFoundError:
        pass
    except Exception as e:
        print(f"CRON-TRUST: state file corrupt, starting fresh ({e})", file=sys.stderr)
    return {"jobs": {}}


def main():
    as_json = "--json" in sys.argv
    window_hours = 24
    for i, arg in enumerate(sys.argv):
        if arg == "--window-hours" and i + 1 < len(sys.argv):
            try:
                window_hours = int(sys.argv[i + 1])
            except ValueError:
                print("CRON-TRUST: bad --window-hours value", file=sys.stderr)
                sys.exit(2)

    runs = []
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            runs.append(json.loads(line))
        except json.JSONDecodeError:
            continue

    if not runs:
        result = {"healthy": True, "message": "no runs in window", "jobs": {}}
        print(json.dumps(result, indent=2) if as_json else "CRON-TRUST: no runs in window")
        sys.exit(0)

    cutoff = datetime.now(timezone.utc) - timedelta(hours=window_hours)

    # Classify; bucket non-terminal separately (never trust math)
    excluded_nonterminal = 0
    by_job = defaultdict(list)
    for run in runs:
        job_id = run.get("job_id", run.get("id", "unknown"))
        honest, reason = classify_run(run)
        if honest is None:
            excluded_nonterminal += 1
            continue
        ts = parse_ts(run.get("ts", run.get("ran_at", run.get("scheduled_for_utc", ""))))
        # scheduled_for_utc is epoch seconds in some feeds
        if ts is None:
            sfu = run.get("scheduled_for_utc")
            if isinstance(sfu, (int, float)):
                ts = datetime.fromtimestamp(sfu, tz=timezone.utc)
        if ts is not None and ts < cutoff:
            continue
        by_job[job_id].append({
            "honest": honest,
            "reason": reason,
            "ts": ts.isoformat() if ts else "",
            "run_id": run.get("run_id", ""),
            "status": run.get("status", ""),
        })

    # Durable watermarks: merge window runs into per-job recent history so
    # consecutive-veto detection survives across monitor invocations.
    state = load_state()
    for job_id, job_runs in by_job.items():
        seen = {r.get("run_id") for r in state["jobs"].get(job_id, {}).get("recent", [])}
        recent = list(state["jobs"].get(job_id, {}).get("recent", []))
        for r in job_runs:
            if r["run_id"] and r["run_id"] not in seen:
                recent.append({"run_id": r["run_id"], "honest": r["honest"], "ts": r["ts"]})
                seen.add(r["run_id"])
        recent.sort(key=lambda x: x["ts"] or "", reverse=True)
        state["jobs"][job_id] = {"recent": recent[:STATE_RECENT_KEEP]}

    issues = []
    job_reports = {}

    for job_id, job_runs in by_job.items():
        job_runs.sort(key=lambda r: r["ts"] or "", reverse=True)
        counts = defaultdict(int)
        for r in job_runs:
            counts[r["honest"]] += 1

        total = len(job_runs)
        genuine = counts["genuine"]
        vetoed = counts["vetoed"]
        skipped = counts["overlap-skip"]
        ambiguous = counts["ambiguous"]
        failed = counts["failed"] + counts["timeout"]

        # Durable consecutive vetoes: leading veto run in merged history
        consec_vetoes = 0
        for r in state["jobs"].get(job_id, {}).get("recent", []):
            if r["honest"] == "vetoed":
                consec_vetoes += 1
            else:
                break

        genuine_rate = genuine / total if total else 0
        ambiguous_rate = ambiguous / total if total else 0
        critical = is_critical(job_id)

        job_reports[job_id] = {
            "total_runs": total,
            "genuine": genuine,
            "vetoed": vetoed,
            "overlap_skip": skipped,
            "coalesced": counts["coalesced"],
            "quota_deferred": counts["quota-deferred"],
            "no_op": counts["no-op"],
            "failed": failed,
            "ambiguous": ambiguous,
            "genuine_rate": round(genuine_rate, 2),
            "consecutive_vetoes": consec_vetoes,
            "critical": critical,
        }

        if consec_vetoes >= 3:
            issues.append({
                "severity": "HIGH",
                "job": job_id,
                "issue": f"{consec_vetoes} consecutive vetoes (durable count) - job is blocked, not running",
                "action": "investigate safety review blocks immediately; job cannot self-heal",
            })
        elif critical and vetoed > 0:
            issues.append({
                "severity": "HIGH",
                "job": job_id,
                "issue": f"critical job vetoed {vetoed}x in window",
                "action": "critical jobs must not be silently blocked",
            })
        elif genuine_rate < 0.5 and total >= 3:
            issues.append({
                "severity": "MEDIUM",
                "job": job_id,
                "issue": f"genuine rate {genuine_rate:.0%} ({genuine}/{total}) - job is unreliable",
                "action": "review job health, consider schedule changes",
            })
        elif ambiguous_rate > 0.5 and total >= 5:
            issues.append({
                "severity": "MEDIUM",
                "job": job_id,
                "issue": f"telemetry gap: {ambiguous}/{total} runs succeeded with empty summaries",
                "action": "worker is not writing result_summary; fix worker reporting, not the schedule",
            })
        elif failed > 0:
            issues.append({
                "severity": "MEDIUM",
                "job": job_id,
                "issue": f"{failed} failed/timed-out runs in window",
                "action": "check error logs",
            })

    # Fleet-wide reactive signal: oversubscription -> auto-stagger, don't just page
    total_runs = sum(v["total_runs"] for v in job_reports.values())
    total_skips = sum(v["overlap_skip"] for v in job_reports.values())
    if total_runs >= 5 and total_skips / total_runs > 0.3:
        offenders = sorted(
            ((jid, v["overlap_skip"]) for jid, v in job_reports.items() if v["overlap_skip"]),
            key=lambda x: x[1], reverse=True,
        )[:5]
        issues.append({
            "severity": "HIGH",
            "job": "*fleet*",
            "issue": (f"{total_skips}/{total_runs} runs overlap-skipped "
                      f"({total_skips / total_runs:.0%}) - cell oversubscribed"),
            "action": ("REACTIVE: stagger the offending jobs now via cron.update - "
                       "lengthen interval to >=2x measured runtime (min 2m), phase-offset "
                       "`at` so they never fire simultaneously, set timeout_secs < interval. "
                       f"Offenders: {', '.join(f'{j}({n})' for j, n in offenders)}"),
            "offenders": [j for j, _ in offenders],
            "remediation": "auto-stagger",
        })

    healthy = len(issues) == 0

    # Durable state + ledger (atomic; failures reported, never swallowed)
    ledger_ok = True
    try:
        atomic_write_text(STATE_PATH, json.dumps(
            {"updated": datetime.now(timezone.utc).isoformat(), "jobs": state["jobs"]}, indent=2))
    except Exception as e:
        ledger_ok = False
        print(f"CRON-TRUST: STATE WRITE FAILED: {e}", file=sys.stderr)

    ledger_entry = {
        "ts": datetime.now(timezone.utc).isoformat(),
        "window_hours": window_hours,
        "jobs_checked": len(job_reports),
        "excluded_nonterminal": excluded_nonterminal,
        "issues_found": len(issues),
        "healthy": healthy,
        "state_ok": ledger_ok,
    }
    try:
        os.makedirs(os.path.dirname(LEDGER_PATH), exist_ok=True)
        with open(LEDGER_PATH, "a") as f:
            f.write(json.dumps(ledger_entry) + "\n")
            f.flush()
            os.fsync(f.fileno())
    except Exception as e:
        ledger_ok = False
        print(f"CRON-TRUST: LEDGER WRITE FAILED: {e}", file=sys.stderr)

    result = {
        "healthy": healthy,
        "jobs": job_reports,
        "issues": issues,
        "excluded_nonterminal": excluded_nonterminal,
        "ledger": LEDGER_PATH,
        "ledger_ok": ledger_ok,
    }

    if as_json:
        print(json.dumps(result, indent=2))
    else:
        if healthy:
            non_genuine = sum(
                v["vetoed"] + v["overlap_skip"] + v["no_op"] + v["failed"]
                for v in job_reports.values())
            if non_genuine:
                print(f"CRON-TRUST: OK - {len(job_reports)} jobs, "
                      f"{non_genuine} non-genuine runs below alert threshold "
                      f"({excluded_nonterminal} non-terminal excluded)")
            else:
                print(f"CRON-TRUST: HEALTHY - {len(job_reports)} jobs, all genuine "
                      f"({excluded_nonterminal} non-terminal excluded)")
        else:
            print(f"CRON-TRUST: {len(issues)} ISSUES")
            for iss in issues:
                print(f"  [{iss['severity']}] {iss['job']}: {iss['issue']}")
                print(f"    -> {iss['action']}")

    sys.exit(0 if healthy else 1)


if __name__ == "__main__":
    main()
