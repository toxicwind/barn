#!/usr/bin/env bash
# set-audio — switch the estate's default audio output and manage the KRK
# Bluetooth monitor path.
#
# Audio topology on this box:
#   krk  -> KRKGoAux3 Bluetooth receiver (A2DP sink) -> KRK monitors  [DESKTOP AUDIO]
#   amp  -> HyperX Amp USB DAC/headphone amp
#   hdmi -> NVIDIA GPU HDMI out (display speakers)
#
# Usage:
#   set-audio                     list sinks + current default
#   set-audio krk|amp|hdmi        make that the default output
#   set-audio balance <L> <R>     per-channel trim (0.0-1.0) on the default sink
#   set-audio balance reset        clear per-channel trim (unity both channels)
#   set-audio autoload            ensure BT is connected, profiles up, sink default
#   set-audio status              one-line summary
#
# The KRK path is Bluetooth (A2DP sink). Its negotiated codec is AAC 48kHz
# stereo; the digital chain is measured balanced, so a left/right level
# difference is downstream of the encoder (receiver DAC / aux cable / monitor
# input trim) and is corrected here with a per-channel digital trim.

set -uo pipefail

BT_DESC="KRKGoAux3"
AMP_DESC="HyperX Amp"
HDMI_DESC="GA102"

# find_sink <description-substring> -> prints the sink name, or empty
find_sink() {
  pactl list sinks 2>/dev/null |
    awk -v want="$1" '
      /^\tName: / { name = $2 }
      /^\tDescription: / {
        desc = $0
        sub(/^[^\t]*Description:[ \t]*/, "", desc)
        if (index(desc, want) > 0) { print name; exit }
      }'
}

default_sink() {
  pactl info 2>/dev/null | sed -n 's/^Default Sink: //p'
}

require_sink() {
  local s
  s="$(find_sink "$1")"
  if [ -z "$s" ]; then
    echo "set-audio: no sink matching '$1' found" >&2
    echo "set-audio: available sinks:" >&2
    pactl list short sinks 2>/dev/null | awk '{print "  " $2 " (" $1 ")"}' >&2
    return 1
  fi
  printf '%s\n' "$s"
}

do_switch() {
  local want="$1" sink
  case "$want" in
    krk)  sink="$(require_sink "$BT_DESC")"   || return 1 ;;
    amp)  sink="$(require_sink "$AMP_DESC")"  || return 1 ;;
    hdmi) sink="$(require_sink "$HDMI_DESC")" || return 1 ;;
    *) echo "set-audio: unknown target '$want' (krk|amp|hdmi)" >&2; return 1 ;;
  esac
  pactl set-default-sink "$sink" || return 1
  echo "default sink -> $sink"
}

do_balance() {
  local l="${1:-}" r="${2:-}" sink
  sink="$(default_sink)"
  if [ -z "$sink" ]; then
    echo "set-audio: no default sink" >&2
    return 1
  fi
  if [ "$l" = "reset" ] || [ "$r" = "reset" ]; then
    pactl set-sink-volume "$sink" 1.0 1.0 || return 1
    echo "balance reset (unity L/R) on $sink"
    return 0
  fi
  case "$l:$r" in
    :*|*:|"")
      echo "set-audio: usage: set-audio balance <L> <R> (both 0.0-1.0)" >&2
      return 1
      ;;
    *[!0-9.:]*)
      echo "set-audio: usage: set-audio balance <L> <R> (both 0.0-1.0)" >&2
      return 1
      ;;
  esac
  pactl set-sink-volume "$sink" "$l" "$r" || return 1
  pactl list sinks 2>/dev/null |
    awk -v s="$sink" '
      $0 ~ ("Name: " s "$") { hit = 1; next }
      hit && /Volume: front-left/ { print; hit = 0; exit }'
}

do_autoload() {
  local mac sink
  # The KRK Bluetooth receiver's MAC is recorded per-device in BlueZ state.
  # Discover it by paired-device name instead of hardcoding.
  mac="$(bluetoothctl devices 2>/dev/null |
    awk -v want="$BT_DESC" '
      { if (index($0, want) > 0) { print $2; exit } }')"
  if [ -z "$mac" ]; then
    echo "set-audio: no paired Bluetooth device matching '$BT_DESC'" >&2
    return 1
  fi

  if ! bluetoothctl info "$mac" 2>/dev/null | grep -q 'Connected: yes'; then
    echo "connecting $mac ..."
    bluetoothctl connect "$mac" >/dev/null 2>&1
    sleep 2
  fi

  # BlueZ only auto-connects a device whose info file carries AutoConnect=true.
  # Ensure it, so the profile comes back on its own after a link drop.
  local info
  info="$(sudo -n find /var/lib/bluetooth -maxdepth 2 -type d -name "$mac" 2>/dev/null | head -1)/info"
  if [ -n "$info" ] && [ -f "$info" ]; then
    if ! sudo -n grep -q '^AutoConnect=true$' "$info" 2>/dev/null; then
      sudo -n sed -i '/^Trusted=true$/a AutoConnect=true' "$info" 2>/dev/null
      echo "enabled AutoConnect for $mac"
    fi
  fi

  sink="$(find_sink "$BT_DESC")"
  if [ -z "$sink" ]; then
    echo "set-audio: BT connected but no A2DP sink exposed yet" >&2
    return 1
  fi
  pactl set-default-sink "$sink" || return 1
  echo "default sink -> $sink (BT profile loaded)"
}

case "${1:-}" in
  ""|list)
    echo "sinks:"
    pactl list short sinks 2>/dev/null | awk '{printf "  %-58s %s\n", $2, $1}'
    echo "default: $(default_sink)"
    ;;
  krk|amp|hdmi) do_switch "$1" ;;
  balance)        do_balance "${2:-}" "${3:-}" ;;
  autoload)       do_autoload ;;
  status)
    echo "default sink : $(default_sink)"
    echo "default src  : $(pactl info 2>/dev/null | sed -n 's/^Default Source: //p')"
    bluetoothctl devices 2>/dev/null | awk -v want="$BT_DESC" '
      index($0, want) > 0 { print "bt device     : " $0 }'
    ;;
  *)
    echo "Usage: set-audio [krk|amp|hdmi|balance <L> <R>|autoload|status|list]" >&2
    exit 1
    ;;
esac
