#!/usr/bin/env bash
# orphan-reaper: kill detached forensics scans that outlive their parent.
# Patch for 2c7ca733 (iowait crash): the ~01:13Z killer was an orphaned
# recursive grep (PPID 1) thrashing ~/workspace.
#
# Kills: rg/grep/find processes whose PPID is 1 (orphaned) AND whose
# command line touches ~/workspace. Dry-run by default; --kill to act.
#
# Tool match is against the executable name (comm), NOT the full command
# line: matching args caused false positives on daemons whose working
# directory merely contains "grep" (e.g. .../ast-grep-napi-fix/...).
#
# Usage: orphan-reaper [--kill] [--max-age SECONDS]
#   Default max-age: 300 (5 min). Anything orphaned longer than that dies.

set -u

KILL=0
MAX_AGE=300

while [[ $# -gt 0 ]]; do
  case "$1" in
    --kill) KILL=1; shift ;;
    --max-age) MAX_AGE="$2"; shift 2 ;;
    *) echo "usage: orphan-reaper [--kill] [--max-age SECONDS]" >&2; exit 1 ;;
  esac
done

NOW=$(date +%s)
KILLED=0

# ps: pid, ppid, etimes (elapsed seconds), executable name, full command
while read -r pid ppid etimes comm args; do
  [[ "$pid" == "PID" ]] && continue
  # Only orphans (PPID 1)
  [[ "$ppid" != "1" ]] && continue
  # Only forensics tools, matched on executable name (comm) — never on args
  case "$comm" in
    rg|grep|egrep|fgrep|find) ;;
    *) continue ;;
  esac
  # Only ones touching the user's workspace (HOME-aware)
  case "$args" in
    *"$HOME/workspace"*|*~/workspace*) ;;
    *) continue ;;
  esac
  # Only ones older than MAX_AGE
  [[ "$etimes" -lt "$MAX_AGE" ]] 2>/dev/null && continue

  if [[ $KILL -eq 1 ]]; then
    kill -9 "$pid" 2>/dev/null && {
      echo "orphan-reaper: KILLED pid=$pid age=${etimes}s cmd=$comm $args"
      KILLED=$((KILLED + 1))
    } || echo "orphan-reaper: failed to kill pid=$pid" >&2
  else
    echo "orphan-reaper: WOULD KILL pid=$pid ppid=$ppid age=${etimes}s cmd=$comm $args"
  fi
done < <(ps -eo pid,ppid,etimes,comm,args 2>/dev/null)

if [[ $KILL -eq 1 ]]; then
  echo "orphan-reaper: killed $KILLED orphan(s)"
else
  echo "orphan-reaper: dry-run (pass --kill to act)"
fi
