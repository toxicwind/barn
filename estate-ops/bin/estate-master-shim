#!/usr/bin/env bun
/**
 * estate-master-shim — Consolidated universal developer shim for estate & ranch
 *
 * Integrates:
 *   1. `bun-auto-trust`: Autonomous detection and npm/bun lifecycle script trust.
 *   2. `direnv-auto-shim`: Canonical .envrc propagation and permission granting.
 *   3. `auto-close-syntax`: AST-aware bracket/delimiter balancing for broken code.
 *   4. `submodules-sync`: High-speed submodule verification and catalog updates.
 *   5. `ffs-diff`: Structural AST outline and markdown semantic diffing.
 */

import { spawnSync } from "node:child_process";
import { resolve, dirname } from "node:path";
import { fileURLToPath } from "node:url";

const SCRIPT_DIR = dirname(fileURLToPath(import.meta.url));

const COMMANDS: Record<string, { desc: string; script: string }> = {
  trust: {
    desc: "Recursively detect projects and auto-trust lifecycle scripts",
    script: `${SCRIPT_DIR}/bun-auto-trust`,
  },
  direnv: {
    desc: "Propagate canonical .envrc shims across all ranch repos",
    script: `${SCRIPT_DIR}/direnv-auto-shim`,
  },
  balance: {
    desc: "AST delimiter balancer — auto-close unclosed (, [, {",
    script: `${SCRIPT_DIR}/auto-close-syntax`,
  },
  submodules: {
    desc: "High-speed autonomous submodule synchronization loop",
    script: `${SCRIPT_DIR}/../mise/tasks/submodules`,
  },
  diff: {
    desc: "Structural AST and markdown semantic diffing engine",
    script: `${SCRIPT_DIR}/ffs-diff`,
  },
};

function runSubcommand(name: string, args: string[]) {
  const target = COMMANDS[name];
  if (!target) {
    console.error(`Unknown subcommand: ${name}`);
    printHelp();
    process.exit(1);
  }
  const proc = spawnSync(target.script, args, { stdio: "inherit" });
  process.exit(proc.status ?? 0);
}

function printHelp() {
  console.log(`
⚡ estate-master-shim — Master Developer Automation Utility

Usage: estate-master-shim <subcommand> [options]

Subcommands:
  all         Run full maintenance suite (trust -> direnv -> submodules)
  trust       Detect Bun workspaces and auto-trust scripts (bun-auto-trust)
  direnv      Apply universal direnv shims across all repos (direnv-auto-shim)
  balance     Auto-close unclosed delimiters/brackets (auto-close-syntax)
  submodules  Run fast submodule sync and catalog generation (mise run submodules)
  diff        Run AST and markdown semantic diff engine (ffs-diff)
`);
}

async function runAll() {
  console.log("🚀 [master-shim] Running full estate maintenance suite...\n");
  for (const cmd of ["trust", "direnv", "submodules"]) {
    console.log(`\n▶️ Executing: estate-master-shim ${cmd}`);
    const proc = spawnSync(COMMANDS[cmd].script, [], { stdio: "inherit" });
    if (proc.status !== 0) {
      console.error(`❌ Command failed: ${cmd}`);
      process.exit(proc.status ?? 1);
    }
  }
  console.log("\n✨ [master-shim] Full maintenance suite completed successfully!");
}

const args = process.argv.slice(2);
const subcmd = args[0];

if (!subcmd || subcmd === "--help" || subcmd === "-h") {
  printHelp();
  process.exit(0);
}

if (subcmd === "all") {
  await runAll();
} else {
  runSubcommand(subcmd, args.slice(1));
}
