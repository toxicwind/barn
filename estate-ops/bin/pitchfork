#!/usr/bin/env bash
# Pitchfork wrapper (estate-owned).
#
# 1. Defaults `pitchfork status` without arguments to `pitchfork list`.
#
# 2. GUARD (2026-10-02, daemon-death incident): refuses mutating commands that
#    target the deprecated `sovereign/<name>` prefix when no such daemon is
#    registered but `estate/<name>` IS. pitchfork's fuzzy name resolution
#    silently maps `pitchfork stop sovereign/herd` onto the live
#    `estate/herd` daemon and SIGTERMs it ("Daemon sovereign/herd not found
#    in config or state" is logged, then the estate daemon dies anyway).
#    Verified twice on 2026-10-02 (16:29 and 17:10): an actor sweeping
#    `pitchfork stop sovereign/<name>` over a stale daemon list killed
#    herd+gatehouse (plus awrawr-mcp, boundless, cuttinggate, model-guard,
#    browser-keeper). Fail closed: refuse with the correct name.
set -uo pipefail
# Resolve the real pitchfork binary. pitchfork is a mise-managed tool in this
# estate (declared in ~/.config/mise/conf.d/00-toolchain.toml), so the source of
# truth is MISE, not a hardcoded version path. Ask `mise which pitchfork` first;
# it honors the currently-declared version column, survives version bumps, and
# returns the mise-managed binary (either the real one or a .mise-bins shim).
# Keep the live install dir + archive copies only as last-resort fallbacks for
# the case where mise itself is unavailable.
_pick_pitchfork() {
  # 1. mise-native resolution (respects the declared pitchfork version).
  local mise have_mise
  mise="${MISE_BIN:-}"
  [ -n "$mise" ] || mise="${HOME}/.local/bin/mise"
  if [ -x "$mise" ]; then
    have_mise="$(command "$mise" which pitchfork 2>/dev/null | head -n1)"
    if [ -n "$have_mise" ] && [ -x "$have_mise" ]; then
      printf '%s\n' "$have_mise"
      return 0
    fi
  fi
  # 2. Direct mise install dir for the declared column (and 'global' marshaller
  #    that mise maintains), resolved without invoking mise.
  local cand install_dir
  install_dir="${HOME}/.local/share/mise/installs/pitchfork"
  for cand in \
    "$install_dir/global/pitchfork" \
    "$install_dir"/2.*/pitchfork \
    "$HOME/.local/bin/pitchfork-bin"; do
    if [ -x "$cand" ]; then printf '%s\n' "$cand"; return 0; fi
  done
  # 3. Archive fallback after the 2026-10-08 home reorg (same SHA as live).
  for cand in \
    "$HOME/archive/home-dirs-2026/.local/share/mise/installs/pitchfork"/2.*/pitchfork \
    "$HOME/archive/home-dirs-2026/.local/bin/pitchfork-bin"; do
    if [ -x "$cand" ]; then printf '%s\n' "$cand"; return 0; fi
  done
  return 1
}
REAL_PITCHFORK="$(_pick_pitchfork)" || { echo "pitchfork: no usable pitchfork binary found" >&2; exit 127; }

if [ "${1:-}" = "status" ] && [ -z "${2:-}" ]; then
  exec "$REAL_PITCHFORK" list
fi

case "${1:-}" in
  stop|restart|kill|clean|c|disable|d|enable|e|start|run|r)
    _pf_ids=""
    for _arg in "${@:2}"; do
      case "$_arg" in
        sovereign/*)
          _short="${_arg#sovereign/}"
          # Fetch the registered daemon id list once per invocation.
          if [ -z "$_pf_ids" ]; then
            _pf_ids="$("$REAL_PITCHFORK" list 2>/dev/null | awk '{print $1}')"
          fi
          if printf '%s\n' "$_pf_ids" | grep -qx "sovereign/${_short}"; then
            : # genuinely registered under sovereign/ — pass through
          elif printf '%s\n' "$_pf_ids" | grep -qx "estate/${_short}"; then
            printf 'pitchfork: REFUSED: "%s" is not a registered daemon id.\n' "$_arg" >&2
            printf 'pitchfork: the live daemon is "estate/%s" — sovereign/ is a deprecated prefix.\n' "$_short" >&2
            printf 'pitchfork: re-run with the estate/ name, or "pitchfork list" to see registered ids.\n' >&2
            exit 1
          fi
          # else: unknown entirely — pass through and let pitchfork report it
          ;;
      esac
    done
    ;;
esac

exec "$REAL_PITCHFORK" "$@"
