#!/usr/bin/env bash
# kf — keyring fetch helper for the secretsmith keyring.
#
# Reads a secret by its key/label and prints the value to stdout.
# Used by ~/.profile (and elsewhere) to surface secrets into the shell env
# without hardcoding them in dotfiles or committing them to git.
#
# Usage:
#   kf <key-label>            print the secret value for <key-label>
#   kf <key-label> --json     print {"key":"...","secret":"..."} (never raw)
#
# Requires: secretsmith (keyring CLI). See docs/secretsmith.md.

set -euo pipefail

label="${1:?usage: kf <key-label> [--json]}"
mode="${2:-}"

val="$(secretsmith search --label "$label" --show 2>/dev/null \
  | sed -n 's/^[[:space:]]*secret = //p' \
  | head -1)"

if [ -z "$val" ]; then
  # fallback: search by free-text query and grab the secret line
  val="$(secretsmith search "$label" --show 2>/dev/null \
    | sed -n 's/^[[:space:]]*secret = //p' \
    | head -1)"
fi

if [ -z "$val" ]; then
  echo "kf: no secret found for '$label'" >&2
  exit 1
fi

if [ "$mode" = "--json" ]; then
  printf '{"key":%s,"secret":%s}\n' "$(printf '%s' "$label" | jq -R .)" "$(printf '%s' "$val" | jq -R .)"
else
  printf '%s\n' "$val"
fi