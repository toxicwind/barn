#!/usr/bin/env bun
/**
 * lane-resume — death-of-a-lane recovery driver (Cinder, subagent-control).
 *
 * When a lane dies mid-turn (pi_check classifier kill, runtime kill, stale
 * heartbeat), the replacement RESUMES from a checkpoint instead of starting
 * over. This script finds the dead and recovers them; agent-checkpoint.ts
 * does the classification + capture + kill-aware brief.
 *
 *   lane-resume scan [--since-hours 24]     list dead-mid-turn agents
 *   lane-resume recover <agent-id> [--name N] [--lane L] [--brief B]
 *                     [--pending P] [--force]
 *                     capture checkpoint + print respawn brief
 *                     (paste the brief into subagent.spawn)
 *
 * Fail-closed: recover refuses agents whose session was modified <10m ago
 * (probably still alive); --force overrides for known-dead agents.
 * The actual subagent.spawn stays with the coordinator — this script never
 * spawns on its own.
 */

import { join, dirname } from "path";
import { existsSync } from "node:fs";

const SCRIPT_DIR = dirname(new URL(import.meta.url).pathname);
const CHECKPOINT_SCRIPT = join(SCRIPT_DIR, "agent-checkpoint.ts");
function defaultAgentsDir(): string {
  if (process.env.CHECKPOINT_AGENTS_DIR) return process.env.CHECKPOINT_AGENTS_DIR;
  if (existsSync("/home/hatch/agents")) return "/home/hatch/agents";
  const h = join(process.env.HOME ?? "/home/hatch", "agents");
  if (existsSync(h)) return h;
  return "/home/hatch/agents";
}
const AGENTS_DIR = defaultAgentsDir();
const REGISTRY_PATH = process.env.LANE_REGISTRY ?? join(process.env.HOME ?? "/home/hatch", "workspace", "lane-registry.json");

function usage(exitCode = 2): never {
  process.stderr.write(`lane-resume — death-of-a-lane recovery driver.

  register --agent-id ID --name NAME --lane "lane/task" --brief "..."
                     [--parent ID] [--chat ID]
      Record a spawn in the registry so recover resolves the real
      lane/persona/brief. Run this right after every subagent.spawn.
  scan [--since-hours 24] [--recover]
      Classify agents with recent session activity; shows which died
      mid-turn and how. --recover auto-captures checkpoints for the dead
      (estate-wide death sweep; fail-closed guard still applies, already
      recovered lanes are skipped).
  recover <agent-id> [flags]  capture checkpoint + print kill-aware respawn
                              brief (paste into subagent.spawn)
      flags: --name --lane --brief --pending --kb-row --fleet-note --force
`);
  process.exit(exitCode);
}

interface ScanRow {
  id: string;
  lines: number;
  ageMin: number;
  kind: string;
  lastStep: string;
}

async function classifyOne(id: string): Promise<ScanRow | null> {
  const f = Bun.file(join(AGENTS_DIR, `agent-${id}`, "sessions", `${id}.jsonl`));
  if (!(await f.exists())) return null;
  const stat = await f.stat();
  const ageMin = (Date.now() - stat.mtime.getTime()) / 60000;
  const lines = (await f.text()).split("\n").filter((l) => l.trim().length > 0);
  if (lines.length === 0) return null;
  // classifyKill is exported from agent-checkpoint.ts; import it directly.
  const mod = await import(CHECKPOINT_SCRIPT);
  const ev = mod.classifyKill(lines) as { kind: string; last_verified_step: string };
  return { id, lines: lines.length, ageMin, kind: ev.kind, lastStep: ev.last_verified_step };
}

interface RegistryEntry {
  name?: string;
  lane?: string;
  brief?: string;
  parent?: string;
  chat?: string;
  registered_at?: string;
  status?: string;
  recovered_at?: string;
  checkpoint?: string;
}

async function loadRegistry(): Promise<Record<string, RegistryEntry>> {
  try {
    const f = Bun.file(REGISTRY_PATH);
    if (!(await f.exists())) return {};
    const j = (await f.json()) as Record<string, RegistryEntry>;
    return j && typeof j === "object" ? j : {};
  } catch {
    return {};
  }
}

function flag(args: string[], name: string): string | undefined {
  const i = args.indexOf(`--${name}`);
  return i >= 0 && i + 1 < args.length ? args[i + 1] : undefined;
}

async function cmdRegister(args: string[]): Promise<void> {
  const id = flag(args, "agent-id");
  const name = flag(args, "name");
  const lane = flag(args, "lane");
  if (!id || !name || !lane) {
    process.stderr.write("register needs --agent-id, --name, --lane (and --brief if you have it)\n");
    process.exit(2);
  }
  const reg = await loadRegistry();
  reg[id] = {
    ...reg[id],
    name,
    lane,
    brief: flag(args, "brief") ?? reg[id]?.brief,
    parent: flag(args, "parent") ?? reg[id]?.parent,
    chat: flag(args, "chat") ?? reg[id]?.chat,
    registered_at: new Date().toISOString(),
    status: "active",
  };
  await Bun.write(REGISTRY_PATH, JSON.stringify(reg, null, 1) + "\n");
  console.log(`registered ${name} (${id.slice(0, 8)}) — ${lane}`);
}

async function cmdScan(args: string[]): Promise<void> {
  let sinceHours = 24;
  const doRecover = args.includes("--recover");
  for (let i = 0; i < args.length; i++) {
    if (args[i] === "--since-hours" && args[i + 1]) sinceHours = parseFloat(args[i + 1]);
  }
  const cutoff = Date.now() - sinceHours * 3600 * 1000;
  const rows: ScanRow[] = [];
  const glob = new Bun.Glob("agent-*/sessions/*.jsonl");
  for await (const p of glob.scan({ cwd: AGENTS_DIR })) {
    const m = p.match(/agent-([0-9a-f-]{36})\/sessions/);
    if (!m) continue;
    const f = Bun.file(join(AGENTS_DIR, p));
    const stat = await f.stat().catch(() => null);
    if (!stat || stat.mtime.getTime() < cutoff) continue;
    const row = await classifyOne(m[1]);
    if (row) rows.push(row);
  }
  rows.sort((a, b) => b.ageMin - a.ageMin);
  console.log(`agent-id(8)  lines  age     kind           last verified step`);
  for (const r of rows) {
    const age = r.ageMin < 60 ? `${r.ageMin.toFixed(0)}m` : `${(r.ageMin / 60).toFixed(1)}h`;
    console.log(
      `${r.id.slice(0, 8)}  ${String(r.lines).padStart(5)}  ${age.padStart(6)}  ${r.kind.padEnd(13)} ${(r.lastStep || "—").slice(0, 70)}`
    );
  }
  const dead = rows.filter((r) => r.kind === "runtime-kill" || r.kind === "refusal-kill");
  console.log(`\n${rows.length} agents scanned, ${dead.length} dead mid-turn (recoverable).`);
  if (!doRecover || dead.length === 0) return;
  // Estate-wide death sweep: auto-capture checkpoints for the dead.
  // Fail-closed guard in recover still applies (fresh sessions refused);
  // already-recovered lanes are skipped via the registry.
  const reg = await loadRegistry();
  let captured = 0, skipped = 0, refused = 0;
  for (const r of dead) {
    if (reg[r.id]?.status === "recovered") {
      console.log(`  skip ${r.id.slice(0, 8)}: already recovered -> ${reg[r.id].checkpoint}`);
      skipped++;
      continue;
    }
    const proc = Bun.spawnSync(
      ["bun", CHECKPOINT_SCRIPT, "recover", "--agent-id", r.id],
      { stdout: "pipe", stderr: "pipe" }
    );
    const out = (proc.stdout?.toString() ?? "") + (proc.stderr?.toString() ?? "");
    const cp = out.match(/^Checkpoint: (\S+)/m);
    if (cp) {
      console.log(`  recovered ${r.id.slice(0, 8)} (${r.kind}) -> ${cp[1]}`);
      captured++;
    } else {
      console.log(`  refused ${r.id.slice(0, 8)}: ${out.split("\n")[0]?.slice(0, 100) ?? "?"}`);
      refused++;
    }
  }
  console.log(`sweep done: ${captured} captured, ${skipped} already recovered, ${refused} refused.`);
}

async function cmdRecover(args: string[]): Promise<void> {
  const id = args[0];
  if (!id) {
    process.stderr.write("recover needs <agent-id>\n");
    process.exit(2);
  }
  const proc = Bun.spawnSync(["bun", CHECKPOINT_SCRIPT, "recover", "--agent-id", id, ...args.slice(1)], {
    stdout: "pipe",
    stderr: "pipe",
  });
  const out = (proc.stdout?.toString() ?? "") + (proc.stderr?.toString() ?? "");
  process.stdout.write(out);
  process.exit(proc.exitCode ?? 1);
}

async function main(): Promise<void> {
  const [cmd, ...rest] = process.argv.slice(2);
  if (cmd === "scan") await cmdScan(rest);
  else if (cmd === "recover") await cmdRecover(rest);
  else if (cmd === "register") await cmdRegister(rest);
  else usage();
}

main().catch((e) => {
  process.stderr.write(`lane-resume: ${e?.message ?? e}\n`);
  process.exit(1);
});
