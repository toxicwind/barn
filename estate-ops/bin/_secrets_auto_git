#!/usr/bin/env bash
# _secrets_auto_git — git wrapper that injects keyring secrets before delegating to git.
#
# Why: the shell alias `git='_secrets_auto_git'` (harness shell init) expects a
# helper on PATH. It was removed from the bin surface, which broke EVERY git
# call in agent shells ("command not found: _secrets_auto_git").
#
# Two roles:
#   1. git wrapper — resolves GitHub credentials from the secretsmith keyring
#      (the SSOT per the estate contract) and exports them into the child
#      process env, then delegates to the real git binary with argv and exit
#      code preserved.
#   2. git credential helper — invoked by git as
#      `git credential-<name> get`, answering with the keyring token. This is
#      what actually authenticates HTTPS pushes: gh's own helper holds a
#      token the API rejects (401) while the keyring token is valid (200),
#      so git must source credentials from the keyring, not from gh.
#
# Keyring resolution: secretsmith env resolves GH_TOKEN -> GITHUB_TOKEN via the
# alias map and emits the whole alias family. The env spec requires at least
# one k=v attribute filter; the generic items carry
# xdg:schema=org.freedesktop.Secret.Generic and nothing else.

set -uo pipefail

# --- credential-helper mode: `git credential-<name> get` ---
if [ "${1:-}" = "credential-_secrets_auto_git" ] || [ "${1:-}" = "credential-secretsmith" ]; then
  shift
  if [ "${1:-}" = "get" ]; then
    if command -v secretsmith >/dev/null 2>&1; then
      tok="$(secretsmith env --env 'GH_TOKEN=xdg:schema=org.freedesktop.Secret.Generic' 2>/dev/null \
        | grep '^GH_TOKEN=' | cut -d= -f2- | tr -d "'")"
      if [ -n "${tok:-}" ]; then
        printf 'protocol=https\nhost=github.com\nusername=x-access-token\npassword=%s\n' "$tok"
        exit 0
      fi
    fi
  fi
  # No credential: exit non-zero so git falls through to the next helper.
  exit 1
fi

REAL_GIT=""
for c in /usr/bin/git /bin/git "$(command -v git 2>/dev/null || true)"; do
  if [ -n "$c" ] && [ -x "$c" ]; then
    # skip ourselves if we ever resolve to a symlink pointing here
    case "$(readlink -f "$c" 2>/dev/null)" in
      *"$(basename "${BASH_SOURCE[0]}")") continue ;;
    esac
    REAL_GIT="$c"
    break
  fi
done

if [ -z "$REAL_GIT" ]; then
  echo "_secrets_auto_git: no real git binary found" >&2
  exit 127
fi

# --- inject keyring secrets (best effort; never block a git call) ---
if [ -z "${GITHUB_TOKEN:-}" ] && command -v secretsmith >/dev/null 2>&1; then
  eval "$(secretsmith env --env 'GH_TOKEN=xdg:schema=org.freedesktop.Secret.Generic' 2>/dev/null)" || true
fi

exec "$REAL_GIT" "$@"
