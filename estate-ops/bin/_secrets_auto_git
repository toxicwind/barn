#!/usr/bin/env bash
# _secrets_auto_git — git wrapper that injects keyring secrets before delegating to git.
#
# Why: the shell alias `git='_secrets_auto_git'` (harness shell init) expects a
# helper on PATH. It was removed from the bin surface, which broke EVERY git
# call in agent shells ("command not found: _secrets_auto_git").
#
# What it does:
#   1. Resolves GitHub credentials from the secretsmith keyring (SSOT).
#   2. Exports them into the child git process env.
#   3. Delegates to the real git binary, passing through argv and exit code.
#
# Auth fallback order (first that yields a token):
#   a. GITHUB_TOKEN already in env
#   b. secretsmith keyring label GITHUB_TOKEN
#   c. secretsmith keyring label GITHUB_TOKEN_CLASSIC
#
# Git's own credential.helper (gh auth git-credential) remains authoritative for
# HTTP auth; this wrapper only guarantees the env surface exists so tooling that
# reads GITHUB_TOKEN (CI scripts, forge, actionlint) works.

set -uo pipefail

REAL_GIT=""
for c in /usr/bin/git /bin/git "$(command -v git 2>/dev/null || true)"; do
  if [ -n "$c" ] && [ -x "$c" ]; then
    # skip ourselves if we ever resolve to a symlink pointing here
    case "$(readlink -f "$c" 2>/dev/null)" in
      *"$(basename "${BASH_SOURCE[0]}")") continue ;;
    esac
    REAL_GIT="$c"
    break
  fi
done

if [ -z "$REAL_GIT" ]; then
  echo "_secrets_auto_git: no real git binary found" >&2
  exit 127
fi

# --- inject keyring secrets (best effort; never block a git call) ---
# secretsmith env resolves GH_TOKEN -> GITHUB_TOKEN via the alias map and emits
# the whole alias family (GH_PAT, GITHUB_PAT, GITHUB_TOKEN, ...). The env spec
# requires at least one k=v attribute filter; the generic items carry
# xdg:schema=org.freedesktop.Secret.Generic and nothing else.
if [ -z "${GITHUB_TOKEN:-}" ] && command -v secretsmith >/dev/null 2>&1; then
  eval "$(secretsmith env --env 'GH_TOKEN=xdg:schema=org.freedesktop.Secret.Generic' 2>/dev/null)" || true
fi

exec "$REAL_GIT" "$@"
