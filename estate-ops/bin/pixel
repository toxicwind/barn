#!/usr/bin/env bun
/**
 * pixel — fast headless bridge to the Architect's Pixel 9 Pro XL (10.0.0.77)
 * over wireless ADB. The SAVED fast route (2026-10-28 session):
 *
 *   Transport : wireless-debug ADB; port rotates. `estate/pixel-adb-keepalive`
 *               (pitchfork) re-scans 30000-50000 every 60s so `adb devices`
 *               is normally already live — connect() only rescues a cold box.
 *   Routing   : http VIEW intents resolve to org.mozilla.fenix
 *               (IntentReceiverActivity) as the SOLE default — `am start`
 *               routes headlessly, no chooser/disambiguator ever appears.
 *   Firewall  : the box nft allowlist (inet awrawr_filter, /etc/nftables.conf)
 *               must include the target port for 10.0.0.0/24 or the phone
 *               gets "Unable to connect" while box-side curl looks fine.
 *
 * Commands:
 *   pixel connect            ensure adb device (rescue path, ~no-op when live)
 *   pixel open <url>         headless VIEW intent (fenix, no chooser)
 *   pixel shot [file]        screenshot (default /tmp/pixel-shot.png)
 *   pixel openshot <url> [file]   open + poll-focus + shot in ONE round trip
 *   pixel tap <x> <y>        tap (coordinates from `pixel ui`)
 *   pixel text <string>      type text
 *   pixel key <keycode>      keyevent (e.g. 4 = BACK, 111 = ESC, 66 = ENTER)
 *   pixel ui                 dump + pull UI hierarchy (for tap targets)
 *   pixel focus              current focused window
 *
 * No fixed sleeps anywhere: short poll loops with hard caps.
 */
import { $ } from "bun";

const SERIAL = "10.0.0.77";

async function liveDevice(): Promise<string | null> {
	const out = await $`adb devices`.quiet().text();
	for (const line of out.split("\n")) {
		if (line.startsWith(`${SERIAL}:`) && line.trimEnd().endsWith("device"))
			return line.split("\t")[0]!;
	}
	return null;
}

async function scanPorts(): Promise<string[]> {
	// fast path: mDNS discovery; fallback: nmap the rotating range
	const mdns = await $`adb mdns services`.quiet().text();
	const ports = [...mdns.matchAll(/10\.0\.0\.77:(\d+)/g)].map((m) => m[1]!);
	if (ports.length) return ports;
	const nmap = await $`nmap -T4 --open -p 30000-50000 10.0.0.77`.quiet().text();
	return [...nmap.matchAll(/^(\d+)\/tcp\s+open/gm)].map((m) => m[1]!);
}

export async function connect(): Promise<string> {
	const live = await liveDevice();
	if (live) return live;
	for (const p of await scanPorts()) {
		await $`adb connect ${`${SERIAL}:${p}`}`.quiet().nothrow();
		const d = await liveDevice();
		if (d) return d;
	}
	console.error("pixel: no adb route — check phone wireless-debug + keepalive daemon");
	process.exit(1);
}

async function adb(...args: string[]): Promise<string> {
	const dev = await connect();
	return $`adb -s ${dev} ${args}`.quiet().text();
}

const [cmd, ...rest] = process.argv.slice(2);
switch (cmd) {
	case "connect": {
		console.log(await connect());
		break;
	}
	case "open": {
		const url = rest[0];
		if (!url) { console.error("usage: pixel open <url>"); process.exit(2); }
		console.log((await adb("shell", "am", "start", "-a", "android.intent.action.VIEW", "-d", url)).trim());
		break;
	}
	case "shot": {
		const file = rest[0] ?? "/tmp/pixel-shot.png";
		const dev = await connect();
		const png = await $`adb -s ${dev} exec-out screencap -p`.quiet().bytes();
		await Bun.write(file, png);
		console.log(`${file} (${png.byteLength} bytes)`);
		break;
	}
	case "openshot": {
		const [url, file = "/tmp/pixel-shot.png"] = rest;
		if (!url) { console.error("usage: pixel openshot <url> [file]"); process.exit(2); }
		const dev = await connect();
		await $`adb -s ${dev} shell am start -a android.intent.action.VIEW -d ${url}`.quiet().nothrow();
		// poll for ANY window focus change (browser may lose focus to user apps — that's fine)
		const t0 = Date.now();
		while (Date.now() - t0 < 4000) {
			const focus = await $`adb -s ${dev} shell dumpsys window`.quiet().text();
			if (/mCurrentFocus=.*(fenix|chrome|WebView)/.test(focus)) break;
			await Bun.sleep(150);
		}
		const png = await $`adb -s ${dev} exec-out screencap -p`.quiet().bytes();
		await Bun.write(file, png);
		console.log(`${file} (${png.byteLength} bytes, ${Date.now() - t0}ms)`);
		break;
	}
	case "tap": {
		const [x, y] = rest;
		if (!x || !y) { console.error("usage: pixel tap <x> <y>"); process.exit(2); }
		console.log((await adb("shell", "input", "tap", x, y)).trim() || "tapped");
		break;
	}
	case "text": {
		if (!rest[0]) { console.error("usage: pixel text <string>"); process.exit(2); }
		console.log((await adb("shell", "input", "text", rest.join(" "))).trim() || "typed");
		break;
	}
	case "key": {
		if (!rest[0]) { console.error("usage: pixel key <keycode>"); process.exit(2); }
		console.log((await adb("shell", "input", "keyevent", rest[0])).trim() || "keyed");
		break;
	}
	case "ui": {
		await adb("shell", "uiautomator", "dump", "/sdcard/pixel-ui.xml");
		const dev = await connect();
		await $`adb -s ${dev} pull /sdcard/pixel-ui.xml /tmp/pixel-ui.xml`.quiet();
		console.log("/tmp/pixel-ui.xml");
		break;
	}
	case "focus": {
		console.log((await adb("shell", "dumpsys window 2>/dev/null | grep mCurrentFocus")).trim());
		break;
	}
	default:
		console.log("commands: connect | open <url> | shot [file] | openshot <url> [file] | tap x y | text s | key kc | ui | focus");
}
