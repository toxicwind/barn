#!/usr/bin/env bash
# tau-relaunch-sessions — restart live tau sessions so they pick up a fresh env.
#
# Why: a long-running tau inherits its environment at start. Config edited
# afterwards (e.g. ~/.bashrc.env deriving OMNIROUTE_URL from the estate port
# SSOT) never reaches the running process, so extensions keep probing stale
# endpoints. WezTerm's CLI server is the same trap: `wezterm cli spawn` hands
# the program the mux server's (long-stale) environment, so a naively spawned
# pane is stale too. Hence every pane is launched through a login bash, which
# re-sources ~/.bashrc.env and ~/.secrets.
#
# No lost work: replacements are spawned and verified to own their session file
# BEFORE any old process is signalled.
#
# Usage:
#   bin/tau-relaunch-sessions            # list live sessions, change nothing
#   bin/tau-relaunch-sessions --apply    # respawn, verify, then stop the old ones
set -euo pipefail

TAU_BIN="/home/toxic/pens/ranch/tau/packages/coding-agent/dist/tau"
# The agent session driving this script must never be killed by it.
SELF_TAU_PID="${TAU_SELF_PID:-}"
# Do not respawn this session's own pane.
SELF_SESSION="${TAU_SELF_SESSION:-}"

log() { printf '[relaunch] %s\n' "$*"; }

# `tau --resume` takes the bare session id (the trailing token of the jsonl
# file name), not the file name and not the "-cwd/date" prefix.
session_id() {
  local base="${1##*/}" id
  id="${base##*_}"
  printf '%s' "${id%.jsonl}"
}

# Live sessions = tau processes holding an open session jsonl.
live_sessions() {
  local pid sess
  for pid in $(pgrep -f "$TAU_BIN" 2>/dev/null || true); do
    [[ "$pid" == "$SELF_TAU_PID" ]] && continue
    # Only TOP-LEVEL sessions live here. Advisor/scout/subagent jsonls are
    # nested one level down and are resumed by their parent, never standalone.
    sess=$(ls -l "/proc/$pid/fd" 2>/dev/null | grep -oE 'sessions/-?[^/]+/[^/]+\.jsonl' | sort -u | head -1) || true
    [[ -n "$sess" ]] || continue
    printf '%s\t%s\n' "$pid" "$(session_id "${sess%.jsonl}")"
  done
}

rows=()
while IFS=$'\t' read -r pid sess; do
  [[ -n "${pid:-}" && -n "${sess:-}" ]] && rows+=("$pid"$'\t'"$sess")
done < <(live_sessions)

if [[ ${#rows[@]} -eq 0 ]]; then
  log "no live tau sessions found"
  exit 0
fi

log "live sessions:"
for r in "${rows[@]}"; do
  pid="${r%%$'\t'*}"
  sess="${r##*$'\t'}"
  if [[ -n "$SELF_SESSION" && "$sess" == "$SELF_SESSION" ]]; then
    log "  pid=$pid session=$sess  (this agent's own session — skipped)"
  else
    log "  pid=$pid session=$sess"
  fi
done

if [[ "${1:-}" != "--apply" ]]; then
  log "dry run — pass --apply to relaunch"
  exit 0
fi

env -p 2>/dev/null | grep -E 'OMNIROUTE_|PI_CODING_AGENT_DIR|PI_CONFIG_DIR' || true

for r in "${rows[@]}"; do
  pid="${r%%$'\t'*}"
  sess="${r##*$'\t'}"
  [[ -n "$SELF_SESSION" && "$sess" == "$SELF_SESSION" ]] && continue
  log "spawning replacement for session $sess"
  # `bash -lc` re-derives OMNIROUTE_URL from the port SSOT inside the new pane;
  # exec makes tau that shell's process, so no stale env can survive.
  wezterm cli spawn --new-window --cwd "${PWD:-$HOME}" -- \
    bash -lc "exec '$TAU_BIN' --resume '$sess'"
done

# Wait for each replacement to claim its session file, then stop the old owner.
for r in "${rows[@]}"; do
  pid="${r%%$'\t'*}"
  sess="${r##*$'\t'}"
  [[ -n "$SELF_SESSION" && "$sess" == "$SELF_SESSION" ]] && continue
  ok=0
  for _ in $(seq 1 30); do
    if pgrep -f "$TAU_BIN --resume $sess\$" >/dev/null 2>&1; then ok=1; break; fi
    sleep 1
  done
  if [[ $ok -eq 1 ]]; then
    log "verified replacement for $sess — stopping old pid $pid"
    kill -TERM "$pid" 2>/dev/null || true
  else
    log "WARNING: no replacement claimed $sess after 30s; keeping old pid $pid"
  fi
done

log "done"