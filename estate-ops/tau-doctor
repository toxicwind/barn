#!/usr/bin/env bash
set -euo pipefail
TAU_REPO="${TAU_REPO:-$HOME/pens/ranch/tau}"
cd "$TAU_REPO/packages/coding-agent"

echo "▸ legacy pi contract"
bun test test/extensibility/legacy-pi-contract.test.ts

echo "▸ legacy pi virtual loader"
bun test test/extensibility/legacy-pi-loader.test.ts

echo "▸ installed plugin imports resolve"
for plugin in "$HOME"/.tau/plugins/node_modules/*/; do
  node -e "
    const p = require('$plugin/package.json');
    console.log('  ' + p.name + ' ✓');
  " 2>/dev/null || echo "  $(basename "$plugin") ✗"
done