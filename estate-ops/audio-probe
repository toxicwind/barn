#!/usr/bin/env bash
# audio-probe — measure the audio chain with hardware, per channel.
#
# Two modes:
#   digital  capture the PipeWire/BlueZ stream itself (no cable needed) and
#            measure per-channel level + spectrum. Proves whether an imbalance
#            exists upstream of the encoder.
#   analog   capture a real line-in jack (motherboard ALC897 "Line In") and
#            measure the same way. This is the only way to see what the KRK
#            monitors actually receive, because the Bluetooth receiver's DAC
#            and the aux cable sit between the digital stream and the speakers.
#
# Playback is a stepped-tone sweep (31 Hz .. 16 kHz, one tone per octave).
# Each tone is analysed separately per channel, yielding a per-channel
# frequency response table plus per-channel level difference. Tone levels are
# kept low (-20 dBFS) and short.
#
# Usage:
#   audio-probe digital [sink-desc]      e.g. audio-probe digital KRKGoAux3
#   audio-probe analog  [source-name]    e.g. audio-probe analog alsa_input.pci-0000_11_00.6.analog-stereo
#   audio-probe tones                    print the tone table
#   audio-probe sweep <freq>             single tone, prints level
#
# Requires: ffmpeg, numpy, scipy, pactl.

set -uo pipefail

TMP="$(mktemp -d /tmp/audio-probe.XXXXXX)"
trap 'rm -rf "$TMP"' EXIT
LEVEL_DB=-20          # conservative: inaudible to most pets
TONE_SECS=0.7
TONE_FREQS="31 63 125 250 500 1000 2000 4000 8000 16000"

find_sink_by_desc() {
  pactl list sinks 2>/dev/null |
    awk -v want="$1" '
      /^\tName: / { name = $2 }
      /^\tDescription: / {
        d = $0; sub(/^[^\t]*Description:[ \t]*/, "", d)
        if (index(d, want) > 0) { print name; exit }
      }'
}

find_source_by_desc() {
  pactl list sources 2>/dev/null |
    awk -v want="$1" '
      /^\tName: / { name = $2 }
      /^\tDescription: / {
        d = $0; sub(/^[^\t]*Description:[ \t]*/, "", d)
        if (index(d, want) > 0) { print name; exit }
      }'
}

# Write the stepped-tone sweep to $1 (wav, 48k stereo).
make_sweep() {
  python3 - "$1" "$TONE_FREQS" "$TONE_SECS" "$LEVEL_DB" <<'PY'
import sys, numpy as np
from scipy.io import wavfile
out, freqs, secs, db = sys.argv[1], sys.argv[2], float(sys.argv[3]), float(sys.argv[4])
sr = 48000
amp = 10 ** (db / 20.0)
tone_list = [int(f) for f in freqs.split()]
chunks = []
for f in tone_list:
    t = np.arange(int(sr * secs)) / sr
    # 20 ms raised-cosine edges so the tone does not click
    edge = int(sr * 0.02)
    w = np.ones(len(t))
    ramp = 0.5 * (1 - np.cos(np.pi * np.arange(edge) / edge))
    w[:edge] = ramp
    w[-edge:] = ramp[::-1]
    chunks.append(amp * w * np.sin(2 * np.pi * f * t))
sig = np.concatenate(chunks)
stereo = np.stack([sig, sig], axis=1)
wavfile.write(out, sr, (stereo * 32767).astype(np.int16))
print(f"sweep: {len(tone_list)} tones x {secs}s = {len(sig)/sr:.1f}s @ {db} dBFS")
PY
}

# Analyse capture $1 against the tone table.
analyze() {
  python3 - "$1" "$2" "$TONE_FREQS" "$TONE_SECS" <<'PY'
import sys, numpy as np
from scipy.io import wavfile

path, label, freqs, secs = sys.argv[1], sys.argv[2], sys.argv[3], float(sys.argv[4])
tone_list = [int(f) for f in freqs.split()]
sr, data = wavfile.read(path)
if data.ndim == 1:
    data = data[:, None]
x = data.astype(np.float64) / 32768.0
n = len(x)
print(f"\n=== {label} ===")
print(f"rate={sr}  frames={n}  duration={n/sr:.2f}s  channels={x.shape[1]}")

frame = int(sr * secs)
if n < frame:
    print("capture too short for tone analysis")
    raise SystemExit(0)

nframes = n // frame
w = np.hanning(frame)
# level per channel per tone
levels = np.zeros((x.shape[1], nframes))
peakf = np.zeros(nframes)
for k in range(nframes):
    seg = x[k * frame:(k + 1) * frame]
    for ch in range(x.shape[1]):
        s = seg[:, ch]
        rms = np.sqrt(np.mean(s ** 2))
        levels[ch, k] = 20 * np.log10(rms) if rms > 1e-9 else -180.0
    S = np.abs(np.fft.rfft(seg[:, 0] * w))
    f = np.fft.rfftfreq(frame, 1 / sr)
    peakf[k] = f[np.argmax(S)]

print("\nper-tone level (dBFS RMS) by channel:")
print(f"{'tone Hz':>9} | {'L rms':>8} {'R rms':>8} | {'L-R':>7} | detected")
for k in range(nframes):
    lp, rp = levels[0, k], levels[1, k]
    d = lp - rp if (lp > -179 and rp > -179) else float('nan')
    print(f"{peakf[k]:9.0f} | {lp:8.2f} {rp:8.2f} | {d:7.2f} | peak {peakf[k]:.0f} Hz")

# Match frames to expected tones by nearest detected peak.
print("\nmatched per-tone response:")
print(f"{'tone Hz':>9} | {'L dB':>8} {'R dB':>8} | {'L-R dB':>8}")
matched = {0: [], 1: []}
for k in range(nframes):
    d = [abs(peakf[k] - t) for t in tone_list]
    idx = int(np.argmin(d))
    if d[idx] / max(tone_list[idx], 1) < 0.25:
        for ch in range(x.shape[1]):
            matched[ch].append((tone_list[idx], levels[ch, k]))
for t in tone_list:
    lv = [dict(matched[ch]).get(t) for ch in range(2)]
    if all(v is not None for v in lv):
        print(f"{t:9d} | {lv[0]:8.2f} {lv[1]:8.2f} | {lv[0]-lv[1]:8.2f}")
    else:
        print(f"{t:9d} | {'--':>8} {'--':>8} | {'--':>8}  (not captured)")

valid = [(t, dict(matched[0])[t], dict(matched[1])[t])
         for t in tone_list if t in dict(matched[0]) and t in dict(matched[1])]
if valid:
    diffs = [l - r for _, l, r in valid]
    mean = float(np.mean(diffs))
    print(f"\nchannel balance over {len(valid)} tones: mean(L-R) = {mean:+.2f} dB")
    if abs(mean) > 1.0:
        side = "LEFT louder" if mean > 0 else "RIGHT louder"
        print(f"  -> {side} by {abs(mean):.2f} dB (digital domain)")
    else:
        print("  -> channels within 1 dB: digital domain is balanced")
PY
}

case "${1:-}" in
  digital)
    desc="${2:-KRKGoAux3}"
    sink="$(find_sink_by_desc "$desc")"
    if [ -z "$sink" ]; then
      echo "audio-probe: no sink matching '$desc'" >&2
      exit 1
    fi
    mon="$sink.monitor"
    make_sweep "$TMP/sweep.wav"
    echo "capturing digital monitor $mon ..."
    parecord --device="$mon" --format=s16le --rate=48000 --channels=2 \
      --latency-msec=200 "$TMP/cap.wav" 2>/dev/null &
    REC=$!
    sleep 1
    paplay --device="$sink" "$TMP/sweep.wav" 2>/dev/null
    wait $REC 2>/dev/null
    analyze "$TMP/cap.wav" "DIGITAL  sink=$sink  monitor=$mon"
    ;;
  analog)
    src="${2:-}"
    if [ -z "$src" ]; then
      src="$(pactl list short sources 2>/dev/null | awk '$2 ~ /analog-stereo/ {print $2; exit}')"
    fi
    if [ -z "$src" ]; then
      echo "audio-probe: no analog source found." >&2
      echo "  Enable the motherboard line-in first:" >&2
      echo "    pactl set-card-profile alsa_card.pci-0000_11_00.6 'output:analog-stereo+input:analog-stereo'" >&2
      exit 1
    fi
    make_sweep "$TMP/sweep.wav"
    echo "capturing analog source $src ..."
    echo "(the tones must be playing out of the KRK during the capture)"
    parecord --device="$src" --format=s16le --rate=48000 --channels=2 \
      --latency-msec=200 "$TMP/cap.wav" 2>/dev/null &
    REC=$!
    sleep 1
    wait $REC 2>/dev/null
    analyze "$TMP/cap.wav" "ANALOG  source=$src"
    ;;
  tones)
    echo "tone table (${TONE_SECS}s each, ${LEVEL_DB} dBFS):"
    for f in $TONE_FREQS; do echo "  ${f} Hz"; done
    ;;
  sweep)
    freq="${2:-440}"
    python3 - "$TMP/tone.wav" "$freq" "$LEVEL_DB" <<'PY'
import sys, numpy as np
from scipy.io import wavfile
out, f, db = sys.argv[1], float(sys.argv[2]), float(sys.argv[3])
sr = 48000
t = np.arange(int(sr * 2)) / sr
amp = 10 ** (db / 20.0)
edge = int(sr * 0.02)
w = np.ones(len(t))
r = 0.5 * (1 - np.cos(np.pi * np.arange(edge) / edge))
w[:edge] = r; w[-edge:] = r[::-1]
sig = amp * w * np.sin(2 * np.pi * f * t)
wavfile.write(out, sr, (np.stack([sig, sig], 1) * 32767).astype(np.int16))
PY
    sink="$(pactl info 2>/dev/null | sed -n 's/^Default Sink: //p')"
    echo "playing ${freq} Hz at ${LEVEL_DB} dBFS on $sink"
    paplay --device="$sink" "$TMP/tone.wav" 2>/dev/null
    ;;
  *)
    echo "Usage: audio-probe digital [desc] | analog [source] | tones | sweep <freq>" >&2
    exit 1
    ;;
esac
