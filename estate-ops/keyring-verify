#!/usr/bin/env bun
/**
 * keyring-verify — round-trip verification of secretsmith keyring vs env file.
 *
 * FAST PATH: bulk --json search + per-item get --json (NO --show, NO banner,
 * single JSON parse). Redaction worked around via: `get --json` returns
 * secret_base64 when --show is NOT passed? — no: it returns secret only with
 * --show. So we use ONE --show spawn per item but with 2s hard timeout and
 * skip-list of labels already known good from a cache file.
 *
 * Actually simplest correct fast path: use --show --json together (returns
 * single JSON with real secret, no banner). Falls back to banner-parse.
 *
 * Usage: keyring-verify [--file PATH] [--json] [--timeout SEC]
 */
import { spawnSync } from "node:child_process";
import { readFileSync, writeFileSync, existsSync } from "node:fs";
import { parseArgs } from "node:util";

const { values } = parseArgs({
  options: {
    file: { type: "string", short: "f", default: "/home/toxic/.secrets" },
    json: { type: "boolean", default: false },
    timeout: { type: "string", default: "2" },
  },
});

const GREEN = "\x1b[32m", RED = "\x1b[31m", DIM = "\x1b[2m", RESET = "\x1b[0m";
const TIMEOUT_MS = Math.max(100, parseInt(values.timeout, 10) * 1000);

function parseEnvFile(text: string): Map<string, string> {
  const out = new Map<string, string>();
  for (const rawLine of text.split("\n")) {
    let line = rawLine.trim();
    if (!line || line.startsWith("#")) continue;
    if (line.startsWith("export ")) line = line.slice(7).trim();
    const eq = line.indexOf("=");
    if (eq < 1) continue;
    const key = line.slice(0, eq).trim();
    let val = line.slice(eq + 1).trim();
    if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'")))
      val = val.slice(1, -1);
    else val = val.split(/\s+#/)[0].trim();
    if (!val || val.includes("${")) continue;
    out.set(key, val);
  }
  return out;
}

const truth = parseEnvFile(readFileSync(values.file, "utf8"));

const listing = JSON.parse(
  spawnSync("secretsmith", ["--json", "search", ""], { encoding: "utf8", timeout: TIMEOUT_MS }).stdout ?? "{}",
);
const items = Array.isArray(listing) ? listing : listing.items ?? [];
const keyringLabels = new Set(items.map((it: any) => it.label));

// Bulk cache: one get per label is unavoidable (dbus), but we probe the
// --show --json combo on ONE label first to detect the fast format.
function fetchSecret(label: string): { secret: string; err?: string } {
  const r = spawnSync("secretsmith", ["get", "--label", label, "--show", "--json"], {
    encoding: "utf8",
    timeout: TIMEOUT_MS,
  });
  if (r.status !== 0) return { secret: "", err: (r.stderr || "exit " + r.status).slice(0, 80) };
  const out = (r.stdout ?? "").trim();
  // If pure JSON, parse directly
  if (out.startsWith("{")) {
    try {
      const d = JSON.parse(out);
      if (typeof d.secret === "string") return { secret: d.secret };
    } catch { /* fall through */ }
  }
  // Banner + JSON: take last { ... } block
  const m = out.match(/\{[\s\S]*\}/);
  if (m) {
    try {
      const d = JSON.parse(m[0]);
      if (typeof d.secret === "string") return { secret: d.secret };
    } catch { /* fall through */ }
  }
  // Banner + raw last line
  const lines = out.split("\n").filter((l) => l.trim());
  return { secret: lines.length ? lines[lines.length - 1] : "" };
}

let matched = 0;
const mismatched: string[] = [];
const absent: string[] = [];
const t0 = performance.now();
let i = 0;

for (const [label, expected] of truth) {
  i++;
  if (!keyringLabels.has(label)) {
    absent.push(label);
    process.stdout.write(`${RED}✗[${i}]${RESET} ${label} ${DIM}ABSENT${RESET}\n`);
    continue;
  }
  const { secret, err } = fetchSecret(label);
  if (err) {
    mismatched.push(label);
    process.stdout.write(`${RED}✗[${i}]${RESET} ${label} ${DIM}ERR ${err}${RESET}\n`);
    continue;
  }
  if (secret === expected) {
    matched++;
    process.stdout.write(`${GREEN}✓[${i}]${RESET} ${label}\n`);
  } else {
    mismatched.push(label);
    process.stdout.write(`${RED}✗[${i}]${RESET} ${label} ${DIM}len ${secret.length}≠${expected.length}${RESET}\n`);
  }
}

const elapsed = ((performance.now() - t0) / 1000).toFixed(2);
const summary = {
  ok: mismatched.length === 0 && absent.length === 0,
  total: truth.size,
  matched,
  mismatched,
  absent,
  elapsed_sec: Number(elapsed),
};
if (values.json) console.log(JSON.stringify(summary, null, 2));
else {
  console.log(`\n${summary.ok ? "✅" : "❌"} ${matched}/${truth.size} exact | ${mismatched.length} mismatched | ${absent.length} absent | ${elapsed}s`);
  if (mismatched.length) console.log("mismatched:", mismatched.join(", "));
  if (absent.length) console.log("absent:", absent.join(", "));
}
if (!summary.ok) process.exitCode = 1;
