#!/usr/bin/env bash
# view-run — View run details and files in /home/toxic/estate/runs/
set -euo pipefail

ESTATE_RUNS="/home/toxic/estate/runs"

if [ -n "${1:-}" ]; then
  RUN_DIR="$ESTATE_RUNS/$1"
else
  RUN_DIR=$(ls -1dt "$ESTATE_RUNS"/*/ 2>/dev/null | head -n 1 || true)
fi

if [ -z "$RUN_DIR" ] || [ ! -d "$RUN_DIR" ]; then
  echo "Error: No run directory found at $RUN_DIR"
  exit 1
fi

echo "════════════════════════════════════════════════════════════════"
echo "RUN DIRECTORY: $RUN_DIR"
echo "════════════════════════════════════════════════════════════════"

if [ -f "$RUN_DIR/manifest.json" ]; then
  echo "MANIFEST:"
  cat "$RUN_DIR/manifest.json"
  echo
fi

echo "FILES:"
ls -lh "$RUN_DIR"
echo "════════════════════════════════════════════════════════════════"
